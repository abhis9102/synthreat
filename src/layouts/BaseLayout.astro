---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  /** Widens main.page for grid/index layouts; article pages keep the narrower reading width. */
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const domainEntries = (await getCollection('domains', ({ data }) => data.status === 'published')).sort(
  (a, b) => a.data.title.localeCompare(b.data.title)
);
const methodologyEntries = (
  await getCollection('methodology', ({ data }) => data.status === 'published')
).sort((a, b) => a.data.title.localeCompare(b.data.title));
const frameworkEntries = (
  await getCollection('frameworks', ({ data }) => data.status === 'published')
).sort((a, b) => a.data.title.localeCompare(b.data.title));
const complianceEntries = (
  await getCollection('compliance', ({ data }) => data.status === 'published')
).sort((a, b) => a.data.title.localeCompare(b.data.title));
const attackEntries = (await getCollection('attacks', ({ data }) => data.status === 'published')).sort(
  (a, b) => a.data.title.localeCompare(b.data.title)
);
const vulnEntries = (
  await getCollection('vulnerabilities', ({ data }) => data.status === 'published')
).sort((a, b) => a.data.title.localeCompare(b.data.title));

// Flat-list nav dropdown: label + base path + entries. Attacks gets the wide multi-column
// treatment separately below since 20 entries doesn't fit one column.
const NAV_SECTIONS = [
  { label: 'Domains', path: 'domains', entries: domainEntries },
  { label: 'Methodology', path: 'methodology', entries: methodologyEntries },
  { label: 'Frameworks', path: 'frameworks', entries: frameworkEntries },
  { label: 'Compliance', path: 'compliance', entries: complianceEntries },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Synthreat</title>
    <meta name="description" content={description} />
    <script is:inline>
      try {
        if (localStorage.getItem('synthreat-theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {}
    </script>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={base}>Synthreat<span class="dot">.</span></a>

        <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav" aria-label="Toggle navigation menu">
          <span></span><span></span><span></span>
        </button>

        <nav class="site-nav" id="siteNav">
          {NAV_SECTIONS.map((section) => (
            <div class="nav-item">
              <div class="nav-row">
                <a href={`${base}${section.path}/`} class="nav-link">
                  {section.label}
                  <svg class="chev" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <button class="nav-chevron" aria-expanded="false" aria-label={`Show ${section.label} submenu`}>
                  <svg width="12" height="7" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
              <div class="nav-panel">
                <div class="nav-panel-inner">
                  <div class="nav-col">
                    {section.entries.map((item) => (
                      <a href={`${base}${section.path}/${item.id}/`}>{item.data.title}</a>
                    ))}
                  </div>
                </div>
                <a class="nav-viewall" href={`${base}${section.path}/`}>View all {section.label} →</a>
              </div>
            </div>
          ))}

          <div class="nav-item">
            <div class="nav-row">
              <a href={`${base}attacks/`} class="nav-link">
                Attacks
                <svg class="chev" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <button class="nav-chevron" aria-expanded="false" aria-label="Show Attacks submenu">
                <svg width="12" height="7" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="nav-panel nav-panel-wide">
              <div class="nav-panel-inner nav-panel-cols">
                {attackEntries.map((item) => (
                  <a href={`${base}attacks/${item.id}/`}>{item.data.title}</a>
                ))}
              </div>
              <a class="nav-viewall" href={`${base}attacks/`}>View all Attack Techniques →</a>
            </div>
          </div>

          <div class="nav-item">
            <div class="nav-row">
              <a href={`${base}vulnerabilities/`} class="nav-link">
                Vulnerabilities
                <svg class="chev" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <button class="nav-chevron" aria-expanded="false" aria-label="Show Vulnerabilities submenu">
                <svg width="12" height="7" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="nav-panel">
              <div class="nav-panel-inner">
                <div class="nav-col">
                  {vulnEntries.map((item) => (
                    <a href={`${base}vulnerabilities/${item.id}/`}>{item.data.title}</a>
                  ))}
                </div>
              </div>
              <a class="nav-viewall" href={`${base}vulnerabilities/`}>View all Vulnerabilities →</a>
            </div>
          </div>
        </nav>

          <button class="theme-toggle" id="themeToggle" type="button" aria-pressed="false" aria-label="Switch to dark mode">
            <svg class="theme-icon theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <svg class="theme-icon theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5 8.5 8.5 0 1 0 20.5 14.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
            <span class="theme-toggle-label">Dark</span>
          </button>
      </div>
    </header>

    <div class="nav-scrim" id="navScrim"></div>

    <main class="page" id="main" class:list={[{ 'page-wide': wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <div class="footer-brand-row">
          <a class="brand" href={base}>Synthreat<span class="dot">.</span></a>
          <p>
            A free, evidence-based cybersecurity education resource for newcomers and client-facing
            security people alike. Real-engagement material referenced anywhere on this site is
            fully genericized before publishing: no real client, system, or data is ever identified.
          </p>
        </div>
        <div class="footer-grid">
          {NAV_SECTIONS.map((section) => (
            <div class="footer-col">
              <span class="footer-col-title">{section.label}</span>
              {section.entries.slice(0, 5).map((item) => (
                <a href={`${base}${section.path}/${item.id}/`}>{item.data.title}</a>
              ))}
              <a href={`${base}${section.path}/`} class="footer-more">View all →</a>
            </div>
          ))}
          <div class="footer-col">
            <span class="footer-col-title">Attacks</span>
            {attackEntries.slice(0, 5).map((item) => (
              <a href={`${base}attacks/${item.id}/`}>{item.data.title}</a>
            ))}
            <a href={`${base}attacks/`} class="footer-more">View all →</a>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">Vulnerabilities</span>
            {vulnEntries.slice(0, 5).map((item) => (
              <a href={`${base}vulnerabilities/${item.id}/`}>{item.data.title}</a>
            ))}
            <a href={`${base}vulnerabilities/`} class="footer-more">View all →</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>Synthreat</span>
        </div>
      </div>
    </footer>

    <script>
      // Markdown-rendered tables have no wrapper element to scroll horizontally on narrow
      // screens, so add one programmatically rather than pulling in a build-time rehype plugin
      // for this alone.
      document.querySelectorAll('article.vuln-body table').forEach((table) => {
        if (table.parentElement?.classList.contains('table-wrap')) return;
        const wrap = document.createElement('div');
        wrap.className = 'table-wrap';
        table.parentNode?.insertBefore(wrap, table);
        wrap.appendChild(table);
      });

      // "Listen to this page": reads the article aloud using the browser's own built-in
      // text-to-speech (no server, no API key, no cost). Only appears on pages that actually have
      // an article body; index and homepage pages have nothing worth reading aloud.
      const listenArticle = document.querySelector('article.vuln-body');
      if (listenArticle && 'speechSynthesis' in window) {
        const bar = document.createElement('div');
        bar.className = 'listen-bar';
        bar.innerHTML = `
          <button class="listen-btn" id="listenBtn" aria-label="Read this page aloud" type="button">
            <svg class="listen-icon listen-icon-play" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 4l14 8-14 8V4Z" fill="currentColor"/></svg>
            <svg class="listen-icon listen-icon-pause" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="6" y="4" width="4" height="16" fill="currentColor"/><rect x="14" y="4" width="4" height="16" fill="currentColor"/></svg>
            <span class="listen-label">Listen to this page</span>
          </button>
          <button class="listen-stop" id="listenStop" aria-label="Stop reading" type="button" hidden>Stop</button>
        `;
        listenArticle.parentNode?.insertBefore(bar, listenArticle);

        const listenBtn = bar.querySelector('#listenBtn');
        const listenStop = bar.querySelector('#listenStop');
        const listenLabel = bar.querySelector('.listen-label');
        let utterance = null;
        let paused = false;

        function readableText() {
          const clone = listenArticle.cloneNode(true);
          clone.querySelectorAll('figure.diagram').forEach((el) => el.remove());
          const h1 = document.querySelector('main h1');
          const lead = (h1 ? h1.textContent + '. ' : '') + clone.textContent.replace(/\s+/g, ' ').trim();
          return lead;
        }

        function setState(state) {
          bar.dataset.state = state;
          listenStop.hidden = state === 'idle';
          listenLabel.textContent = state === 'playing' ? 'Pause' : state === 'paused' ? 'Resume' : 'Listen to this page';
        }
        setState('idle');

        listenBtn.addEventListener('click', () => {
          if (!utterance || (!window.speechSynthesis.speaking && !paused)) {
            utterance = new SpeechSynthesisUtterance(readableText());
            utterance.onend = () => setState('idle');
            utterance.onerror = () => setState('idle');
            window.speechSynthesis.speak(utterance);
            paused = false;
            setState('playing');
          } else if (!paused) {
            window.speechSynthesis.pause();
            paused = true;
            setState('paused');
          } else {
            window.speechSynthesis.resume();
            paused = false;
            setState('playing');
          }
        });

        listenStop.addEventListener('click', () => {
          window.speechSynthesis.cancel();
          paused = false;
          setState('idle');
        });
      }

      // Mobile nav: hover/focus-within handles the desktop dropdowns with no JS at all. Below the
      // desktop breakpoint there's no hover, so the hamburger and per-item chevrons need a toggle.
      const navToggle = document.getElementById('navToggle');
      const siteNav = document.getElementById('siteNav');
      const navScrim = document.getElementById('navScrim');

      function closeNav() {
        siteNav?.classList.remove('open');
        navToggle?.setAttribute('aria-expanded', 'false');
        navScrim?.classList.remove('open');
        document.querySelectorAll('.nav-item.open').forEach((el) => el.classList.remove('open'));
      }

      navToggle?.addEventListener('click', () => {
        const isOpen = siteNav?.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', String(!!isOpen));
        navScrim?.classList.toggle('open', !!isOpen);
      });
      navScrim?.addEventListener('click', closeNav);

      document.querySelectorAll<HTMLButtonElement>('.nav-chevron').forEach((btn) => {
        btn.addEventListener('click', () => {
          const item = btn.closest('.nav-item');
          const isOpen = item?.classList.toggle('open');
          btn.setAttribute('aria-expanded', String(!!isOpen));
        });
      });


      // Theme preference: light is the default, and an explicit choice persists across visits.
      const themeToggle = document.getElementById('themeToggle');

      function applyTheme(theme, persist = true) {
        const isDark = theme === 'dark';
        document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
        themeToggle?.setAttribute('aria-pressed', String(isDark));
        themeToggle?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        const label = themeToggle?.querySelector('.theme-toggle-label');
        if (label) label.textContent = isDark ? 'Light' : 'Dark';
        if (persist) {
          try { localStorage.setItem('synthreat-theme', isDark ? 'dark' : 'light'); } catch {}
        }
      }

      let savedTheme = null;
      try { savedTheme = localStorage.getItem('synthreat-theme'); } catch {}
      applyTheme(savedTheme === 'dark' ? 'dark' : 'light', false);
      themeToggle?.addEventListener('click', () => {
        applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeNav();
      });
    </script>
  </body>
</html>

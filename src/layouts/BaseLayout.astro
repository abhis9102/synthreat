---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { VULN_SURFACES } from '../content.config';
import AiChatPopup from '../components/AiChatPopup.astro';

interface Props {
  title: string;
  description: string;
  /** Widens main.page for grid/index layouts; article pages keep the narrower reading width. */
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const defaultKey = process.env.GEMINI_API_KEY || import.meta.env.GEMINI_API_KEY || '';
const isAssistantPage = Astro.url.pathname.includes('/assistant');

const domainEntries = (await getCollection('domains', ({ data }) => data.status === 'published')).sort(
  (a, b) => a.data.title.localeCompare(b.data.title)
);
const methodologyEntries = (
  await getCollection('methodology', ({ data }) => data.status === 'published')
).sort((a, b) => a.data.title.localeCompare(b.data.title));
const frameworkEntries = (
  await getCollection('frameworks', ({ data }) => data.status === 'published')
).sort((a, b) => a.data.title.localeCompare(b.data.title));
const complianceEntries = (
  await getCollection('compliance', ({ data }) => data.status === 'published')
).sort((a, b) => a.data.title.localeCompare(b.data.title));
const attackEntries = (await getCollection('attacks', ({ data }) => data.status === 'published')).sort(
  (a, b) => a.data.title.localeCompare(b.data.title)
);
const vulnEntries = (
  await getCollection('vulnerabilities', ({ data }) => data.status === 'published')
).sort((a, b) => a.data.title.localeCompare(b.data.title));

// Nested nav dropdown for Vulnerabilities: surface (top level, same grouping and order as the index
// page) -> a flyout panel of that surface's entries. For WebApp Security specifically, the flyout
// lists the 10 OWASP categories themselves (short label + count, linking to that category's anchor
// on the index page) rather than exploding into a 22-link, multi-column breakdown: the full
// per-page breakdown is what the index page itself is for, and a hover dropdown reading that deep
// stopped being a dropdown and became its own page. Cloud/AI/Mobile/Network stay a flat list of
// their actual entries since none of them are large enough yet to need this treatment.
const surfaceSlug = (surface: string) => surface.toLowerCase().replace(/\s+/g, '-');
// "A01:2021 – Broken Access Control" -> "A01 · Broken Access Control"
const owaspShortLabel = (owasp: string) => {
  const code = owasp.match(/^A\d{2}/)?.[0] ?? '';
  const name = owasp.split('–')[1]?.trim() ?? owasp;
  return `${code} · ${name}`;
};
const vulnGroups = VULN_SURFACES.map((surface) => {
  const surfaceEntries = vulnEntries.filter((entry) => entry.data.surface === surface);
  let subgroups: { code: string; label: string; count: number }[] | null = null;
  if (surface === 'WebApp Security') {
    const byCode = new Map<string, { code: string; label: string; count: number }>();
    for (const entry of surfaceEntries) {
      const code = entry.data.owasp?.match(/^A\d{2}/)?.[0] ?? 'Other';
      if (!byCode.has(code)) byCode.set(code, { code, label: entry.data.owasp ? owaspShortLabel(entry.data.owasp) : 'Other', count: 0 });
      byCode.get(code)!.count++;
    }
    subgroups = [...byCode.values()].sort((a, b) => a.code.localeCompare(b.code));
  }
  return { surface, entries: surfaceEntries, subgroups };
}).filter((group) => group.entries.length > 0);

// Flat-list nav dropdown: label + base path + entries. Attacks gets the wide multi-column
// treatment separately below since 20 entries doesn't fit one column.
const NAV_SECTIONS = [
  { label: 'Domains', path: 'domains', entries: domainEntries },
  { label: 'Methodology', path: 'methodology', entries: methodologyEntries },
  { label: 'Frameworks', path: 'frameworks', entries: frameworkEntries },
  { label: 'Compliance', path: 'compliance', entries: complianceEntries },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Synthreat</title>
    <meta name="description" content={description} />
    <script is:inline>
      try {
        if (localStorage.getItem('synthreat-theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch {}
    </script>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={base}>Synthreat<span class="dot">.</span></a>

        <nav class="site-nav" id="siteNav">
          <button class="nav-close" id="navClose" aria-label="Close navigation menu">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
          {NAV_SECTIONS.map((section) => (
            <div class="nav-item">
              <div class="nav-row">
                <a href={`${base}${section.path}/`} class="nav-link">
                  {section.label}
                  <svg class="chev" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <button class="nav-chevron" aria-expanded="false" aria-label={`Show ${section.label} submenu`}>
                  <svg width="12" height="7" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
              <div class="nav-panel">
                <div class="nav-panel-inner">
                  <div class="nav-col">
                    {section.entries.map((item) => (
                      <a href={`${base}${section.path}/${item.id}/`}>{item.data.title}</a>
                    ))}
                  </div>
                </div>
                <a class="nav-viewall" href={`${base}${section.path}/`}>View all {section.label} →</a>
              </div>
            </div>
          ))}

          <div class="nav-item">
            <div class="nav-row">
              <a href={`${base}attacks/`} class="nav-link">
                Attacks
                <svg class="chev" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <button class="nav-chevron" aria-expanded="false" aria-label="Show Attacks submenu">
                <svg width="12" height="7" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="nav-panel nav-panel-wide">
              <div class="nav-panel-inner nav-panel-cols">
                {attackEntries.map((item) => (
                  <a href={`${base}attacks/${item.id}/`}>{item.data.title}</a>
                ))}
              </div>
              <a class="nav-viewall" href={`${base}attacks/`}>View all Attack Techniques →</a>
            </div>
          </div>

          <div class="nav-item">
            <div class="nav-row">
              <a href={`${base}vulnerabilities/`} class="nav-link">
                Vulnerabilities
                <svg class="chev" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <button class="nav-chevron" aria-expanded="false" aria-label="Show Vulnerabilities submenu">
                <svg width="12" height="7" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="nav-panel">
              <div class="vuln-surface-list">
                {vulnGroups.map((group) => (
                  <div class="vuln-surface-item">
                    <a href={`${base}vulnerabilities/${surfaceSlug(group.surface)}/`} class="vuln-surface-row">
                      <span>{group.surface}</span>
                      <span class="vuln-surface-count">{group.entries.length}</span>
                    </a>
                    <div class="vuln-surface-panel">
                      {group.subgroups ? (
                        group.subgroups.map((sub) => (
                          <a href={`${base}vulnerabilities/${surfaceSlug(group.surface)}/#${sub.code.toLowerCase()}`}>
                            {sub.label} <span class="vuln-surface-count">{sub.count}</span>
                          </a>
                        ))
                      ) : (
                        group.entries.map((item) => (
                          <a href={`${base}vulnerabilities/${item.id}/`}>{item.data.title}</a>
                        ))
                      )}
                    </div>
                  </div>
                ))}
              </div>
              <a class="nav-viewall" href={`${base}vulnerabilities/`}>View all Vulnerabilities →</a>
            </div>
          </div>

          <div class="nav-item">
            <div class="nav-row">
              <a href={`${base}assistant/`} class="nav-link nav-link-assistant">
                <span class="nav-ai-spark">✦</span>
                <span>Synthreat AI</span>
              </a>
            </div>
          </div>

          <div class="nav-item">
            <div class="nav-row">
              <a href={`${base}paths/`} class="nav-link">
                <span>🏷️ Paths</span>
              </a>
            </div>
          </div>
        </nav>

        <div class="header-actions">
          <button class="theme-toggle" id="themeToggle" type="button" aria-pressed="false" aria-label="Switch to dark mode">
            <svg class="theme-icon theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <svg class="theme-icon theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5 8.5 8.5 0 1 0 20.5 14.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
            <span class="theme-toggle-label">Dark</span>
          </button>

          <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav" aria-label="Toggle navigation menu">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <div class="nav-scrim" id="navScrim"></div>

    <main class="page" id="main" class:list={[{ 'page-wide': wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <div class="footer-brand-row">
          <a class="brand" href={base}>Synthreat<span class="dot">.</span></a>
          <p>
            A free, evidence-based cybersecurity education resource for newcomers and client-facing
            security people alike. Real-engagement material referenced anywhere on this site is
            fully genericized before publishing: no real client, system, or data is ever identified.
          </p>
        </div>
        <div class="footer-grid">
          {NAV_SECTIONS.map((section) => (
            <div class="footer-col">
              <span class="footer-col-title">{section.label}</span>
              {section.entries.slice(0, 5).map((item) => (
                <a href={`${base}${section.path}/${item.id}/`}>{item.data.title}</a>
              ))}
              <a href={`${base}${section.path}/`} class="footer-more">View all →</a>
            </div>
          ))}
          <div class="footer-col">
            <span class="footer-col-title">Attacks</span>
            {attackEntries.slice(0, 5).map((item) => (
              <a href={`${base}attacks/${item.id}/`}>{item.data.title}</a>
            ))}
            <a href={`${base}attacks/`} class="footer-more">View all →</a>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">Vulnerabilities</span>
            {vulnEntries.slice(0, 5).map((item) => (
              <a href={`${base}vulnerabilities/${item.id}/`}>{item.data.title}</a>
            ))}
            <a href={`${base}vulnerabilities/`} class="footer-more">View all →</a>
          </div>
          <div class="footer-col">
            <span class="footer-col-title">Intelligence & Practice</span>
            <a href={`${base}assistant/`}>Synthreat AI (Dual Lens)</a>
            <a href={`${base}paths/`}>Learning Paths</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>Synthreat</span>
        </div>
      </div>
    </footer>

    <script>
      // Markdown-rendered tables have no wrapper element to scroll horizontally on narrow
      // screens, so add one programmatically rather than pulling in a build-time rehype plugin
      // for this alone.
      document.querySelectorAll('article.vuln-body table').forEach((table) => {
        if (table.parentElement?.classList.contains('table-wrap')) return;
        const wrap = document.createElement('div');
        wrap.className = 'table-wrap';
        table.parentNode?.insertBefore(wrap, table);
        wrap.appendChild(table);
      });

      // "Listen to this page": reads the article aloud using the browser's own built-in
      // text-to-speech (no server, no API key, no cost). Only appears on pages that actually have
      // an article body; index and homepage pages have nothing worth reading aloud.
      const listenArticle = document.querySelector('article.vuln-body');
      if (listenArticle && 'speechSynthesis' in window) {
        const bar = document.createElement('div');
        bar.className = 'listen-bar';
        bar.innerHTML = `
          <button class="listen-btn" id="listenBtn" aria-label="Read this page aloud" type="button">
            <svg class="listen-icon listen-icon-play" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 4l14 8-14 8V4Z" fill="currentColor"/></svg>
            <svg class="listen-icon listen-icon-pause" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="6" y="4" width="4" height="16" fill="currentColor"/><rect x="14" y="4" width="4" height="16" fill="currentColor"/></svg>
            <span class="listen-label">Listen to this page</span>
          </button>
          <button class="listen-stop" id="listenStop" aria-label="Stop reading" type="button" hidden>Stop</button>
        `;
        listenArticle.parentNode?.insertBefore(bar, listenArticle);

        const listenBtn = bar.querySelector('#listenBtn');
        const listenStop = bar.querySelector('#listenStop');
        const listenLabel = bar.querySelector('.listen-label');
        let utterance = null;
        let paused = false;

        // Prefer "Samantha" (en-US), a widely available, clear-sounding voice on Apple platforms,
        // over whatever the browser would otherwise default to. Falls back to the browser's own
        // default automatically wherever Samantha isn't available (most non-Apple platforms).
        // Chrome loads its voice list asynchronously via 'voiceschanged', so this is checked again
        // once that fires in case the first lookup ran before voices were ready.
        let preferredVoice = null;
        function pickPreferredVoice() {
          const voices = window.speechSynthesis.getVoices();
          preferredVoice = voices.find(
            (v) => v.name.toLowerCase() === 'samantha' && v.lang?.toLowerCase() === 'en-us'
          ) ?? null;
        }
        pickPreferredVoice();
        if ('onvoiceschanged' in window.speechSynthesis) {
          window.speechSynthesis.addEventListener('voiceschanged', pickPreferredVoice);
        }

        function readableText() {
          const clone = listenArticle.cloneNode(true);
          clone.querySelectorAll('figure.diagram').forEach((el) => el.remove());
          const h1 = document.querySelector('main h1');
          const lead = (h1 ? h1.textContent + '. ' : '') + clone.textContent.replace(/\s+/g, ' ').trim();
          return lead;
        }

        function setState(state) {
          bar.dataset.state = state;
          listenStop.hidden = state === 'idle';
          listenLabel.textContent = state === 'playing' ? 'Pause' : state === 'paused' ? 'Resume' : 'Listen to this page';
        }
        setState('idle');

        listenBtn.addEventListener('click', () => {
          if (!utterance || (!window.speechSynthesis.speaking && !paused)) {
            utterance = new SpeechSynthesisUtterance(readableText());
            if (preferredVoice) utterance.voice = preferredVoice;
            utterance.onend = () => setState('idle');
            utterance.onerror = () => setState('idle');
            window.speechSynthesis.speak(utterance);
            paused = false;
            setState('playing');
          } else if (!paused) {
            window.speechSynthesis.pause();
            paused = true;
            setState('paused');
          } else {
            window.speechSynthesis.resume();
            paused = false;
            setState('playing');
          }
        });

        listenStop.addEventListener('click', () => {
          window.speechSynthesis.cancel();
          paused = false;
          setState('idle');
        });
      }

      // Mobile nav: hover/focus-within handles the desktop dropdowns with no JS at all. Below the
      // desktop breakpoint there's no hover, so the hamburger and per-item chevrons need a toggle.
      const navToggle = document.getElementById('navToggle');
      const siteNav = document.getElementById('siteNav');
      const navScrim = document.getElementById('navScrim');

      function closeNav() {
        siteNav?.classList.remove('open');
        navToggle?.setAttribute('aria-expanded', 'false');
        navScrim?.classList.remove('open');
        document.querySelectorAll('.nav-item.open').forEach((el) => el.classList.remove('open'));
      }

      navToggle?.addEventListener('click', () => {
        const isOpen = siteNav?.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', String(!!isOpen));
        navScrim?.classList.toggle('open', !!isOpen);
      });
      navScrim?.addEventListener('click', closeNav);
      document.getElementById('navClose')?.addEventListener('click', closeNav);

      document.querySelectorAll<HTMLButtonElement>('.nav-chevron').forEach((btn) => {
        btn.addEventListener('click', () => {
          const item = btn.closest('.nav-item');
          const isOpen = item?.classList.toggle('open');
          btn.setAttribute('aria-expanded', String(!!isOpen));
        });
      });


      // Theme preference: light is the default, and an explicit choice persists across visits.
      const themeToggle = document.getElementById('themeToggle');

      function applyTheme(theme, persist = true) {
        const isDark = theme === 'dark';
        document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
        themeToggle?.setAttribute('aria-pressed', String(isDark));
        themeToggle?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        const label = themeToggle?.querySelector('.theme-toggle-label');
        if (label) label.textContent = isDark ? 'Light' : 'Dark';
        if (persist) {
          try { localStorage.setItem('synthreat-theme', isDark ? 'dark' : 'light'); } catch {}
        }
      }

      let savedTheme = null;
      try { savedTheme = localStorage.getItem('synthreat-theme'); } catch {}
      applyTheme(savedTheme === 'dark' ? 'dark' : 'light', false);
      themeToggle?.addEventListener('click', () => {
        applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeNav();
      });

      // Render Mermaid diagrams
      const mermaidElements = document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]');
      if (mermaidElements.length > 0) {
        import('mermaid').then(({ default: mermaid }) => {
          function getMermaidConfig(isDark: boolean) {
            return {
              startOnLoad: false,
              securityLevel: 'loose' as const,
              fontFamily: "'Archivo', system-ui, -apple-system, sans-serif",
              fontSize: 13,
              theme: 'base' as const,
              flowchart: {
                htmlLabels: true,
                curve: 'basis' as const,
                padding: 14,
                nodeSpacing: 32,
                rankSpacing: 32,
                useMaxWidth: false
              },
              sequence: {
                diagramMarginX: 20,
                diagramMarginY: 20,
                actorMargin: 50,
                width: 160,
                height: 46,
                boxMargin: 10,
                boxTextMargin: 5,
                noteMargin: 10,
                messageMargin: 36,
                mirrorActors: false,
                bottomMarginAdj: 1,
                useMaxWidth: false,
                rightAngles: false,
                showSequenceNumbers: false
              },
              themeCSS: `
                .node .label, .node .nodeLabel, .node p {
                  font-family: 'Archivo', system-ui, -apple-system, sans-serif;
                  font-size: 13px;
                  line-height: 1.45;
                  text-align: center;
                  margin: 0;
                }
                .cluster text, .cluster span.nodeLabel {
                  font-family: 'Archivo', system-ui, -apple-system, sans-serif;
                  font-size: 11.5px;
                  font-weight: 700;
                  text-transform: uppercase;
                  letter-spacing: 0.04em;
                }
                .edgeLabel, .edgeLabel span, .edgeLabel p {
                  font-family: 'Archivo', system-ui, -apple-system, sans-serif;
                  font-size: 12px;
                  line-height: 1.35;
                  margin: 0;
                }
                .edgeLabel span {
                  padding: 2px 7px;
                  border: 1px solid #CBD5E1;
                  border-radius: 6px;
                }
                p {
                  margin: 0;
                }
                code {
                  font-family: 'JetBrains Mono', monospace;
                  font-size: 11.5px;
                  padding: 1px 4px;
                  white-space: nowrap;
                }
              `,
              themeVariables: isDark ? {
                darkMode: true,
                background: 'transparent',
                primaryColor: '#181F2A',
                primaryTextColor: '#F1F5F9',
                primaryBorderColor: '#334155',
                lineColor: '#94A3B8',
                secondaryColor: '#1E293B',
                tertiaryColor: '#0F172A',
                clusterBkg: '#111722',
                clusterBorder: '#263344',
                edgeLabelBackground: '#181F2A',
                noteBkgColor: '#2A180F',
                noteTextColor: '#FFC4A3',
                noteBorderColor: '#492A18',
                actorBkg: '#181F2A',
                actorTextColor: '#F1F5F9',
                actorBorder: '#334155',
                actorLineColor: '#334155',
                signalColor: '#94A3B8',
                signalTextColor: '#F1F5F9',
                labelBoxBkgColor: '#181F2A',
                labelBoxBorderColor: '#334155',
                labelTextColor: '#F1F5F9',
                loopTextColor: '#94A3B8',
                activationBorderColor: '#FF7A45',
                activationBkgColor: '#2A180F',
                sequenceNumberColor: '#FFC4A3'
              } : {
                darkMode: false,
                background: 'transparent',
                primaryColor: '#F8FAFC',
                primaryTextColor: '#0F172A',
                primaryBorderColor: '#CBD5E1',
                lineColor: '#64748B',
                secondaryColor: '#F1F5F9',
                tertiaryColor: '#FFFFFF',
                clusterBkg: '#F8FAFC',
                clusterBorder: '#E2E8F0',
                edgeLabelBackground: '#FFFFFF',
                noteBkgColor: '#FBE9E1',
                noteTextColor: '#8F3313',
                noteBorderColor: '#F0C9B6',
                actorBkg: '#F8FAFC',
                actorTextColor: '#0F172A',
                actorBorder: '#CBD5E1',
                actorLineColor: '#CBD5E1',
                signalColor: '#334155',
                signalTextColor: '#0F172A',
                labelBoxBkgColor: '#F1F5F9',
                labelBoxBorderColor: '#CBD5E1',
                labelTextColor: '#0F172A',
                loopTextColor: '#64748B',
                activationBorderColor: '#C4491D',
                activationBkgColor: '#FBE9E1',
                sequenceNumberColor: '#8F3313'
              }
            };
          }

          let diagramIdCounter = 0;
          async function renderAllDiagrams() {
            if (document.fonts?.ready) {
              await document.fonts.ready;
            }
            const isDark = document.documentElement.dataset.theme === 'dark';
            mermaid.initialize(getMermaidConfig(isDark));

            const containers = document.querySelectorAll<HTMLElement>('figure.mermaid-diagram');
            for (const container of containers) {
              let code = container.dataset.src;
              if (!code) continue;

              // Convert stick-figure actors to clean rectangular participants
              code = code.replace(/^\s*actor\s+/gm, '    participant ');
              // Remove raw autonumber circles to avoid line collisions
              code = code.replace(/^\s*autonumber\s*$/gm, '');

              const isSequence = /^\s*sequenceDiagram/m.test(code);
              const id = `mermaid-svg-${diagramIdCounter++}`;
              try {
                let { svg } = await mermaid.render(id, code);

                if (isDark) {
                  // In dark mode, ensure breach and safe node fills adapt to dark theme with proper high contrast
                  svg = svg.replace(/fill:#fee2e2/g, 'fill:#2A180F');
                  svg = svg.replace(/fill:#dcfce7/g, 'fill:#0f291e');
                  svg = svg.replace(/fill:#ffedd5/g, 'fill:#2b1d0c');
                  svg = svg.replace(/fill:#f8fafc/g, 'fill:#181F2A');
                  svg = svg.replace(/fill:#f1f5f9/g, 'fill:#1e293b');
                  svg = svg.replace(/fill:#eff6ff/g, 'fill:#172554');
                }

                // Determine if diagram fits cleanly on mobile screens (not sequence, natural width <= 600px)
                const vbMatch = svg.match(/viewBox=["']\s*([-\d.]+)\s+([-\d.]+)\s+([\d.]+)\s+([\d.]+)/);
                const vbWidth = vbMatch ? parseFloat(vbMatch[3]) : 0;
                const fitsMobile = !isSequence && vbWidth > 0 && vbWidth <= 600;

                container.classList.remove('diagram-mobile-fit', 'diagram-desktop-only');
                container.classList.add(fitsMobile ? 'diagram-mobile-fit' : 'diagram-desktop-only');

                const toolbar = `
                  <div class="diagram-toolbar">
                    <div class="diagram-tag">
                      <span class="diagram-indicator"></span>
                      <span class="diagram-title">${isSequence ? 'ATTACK EXECUTION SEQUENCE' : 'TRUST BOUNDARY & FLOW ARCHITECTURE'}</span>
                    </div>
                    <span class="diagram-badge">${isSequence ? 'PROTOCOL TIMELINE' : 'SYSTEM BOUNDARIES'}</span>
                  </div>
                `;
                container.innerHTML = `${toolbar}<div class="diagram-canvas">${svg}</div>`;
              } catch (err) {
                console.error('Failed to render Mermaid diagram:', err);
              }
            }
          }

          // Initial conversion from <pre> to <figure>
          mermaidElements.forEach((pre) => {
            const code = pre.textContent?.trim() || '';
            const isSequence = /^\s*sequenceDiagram/m.test(code);
            const figure = document.createElement('figure');
            figure.className = `diagram mermaid-diagram ${isSequence ? 'diagram-desktop-only' : 'diagram-mobile-fit'}`;
            figure.dataset.src = code;
            pre.replaceWith(figure);
          });

          renderAllDiagrams();

          // Re-render when theme is toggled
          themeToggle?.addEventListener('click', () => {
            setTimeout(renderAllDiagrams, 50);
          });
        });
      }
    </script>
    {!isAssistantPage && <AiChatPopup defaultKey={defaultKey} base={base} />}
  </body>
</html>

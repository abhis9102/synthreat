---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('methodology', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  wide
  title="Methodology"
  description="How security is actually tested and delivered: penetration testing, red teaming, AI red teaming, continuous threat exposure management, and PTaaS."
>
  <span class="tagline">Index</span>
  <h1>Methodology</h1>
  <p style="font-size:17px;color:var(--ink-soft);margin-top:14px;max-width:70ch;">
    How security is actually tested, and how that testing gets delivered. Distinct from a domain
    (what's being tested) and from a framework or compliance regime (what external standard governs
    it) — this is the practice itself, end to end.
  </p>

  <div class="card-grid" style="margin-top:36px;">
    {entries.map((entry) => (
      <a href={`${base}methodology/${entry.id}/`} class="card">
        <h3>{entry.data.title}</h3>
        <p>{entry.data.summary}</p>
      </a>
    ))}
    {entries.length === 0 && (
      <p style="color:var(--ink-faint);">Nothing published yet — check back soon.</p>
    )}
  </div>
</BaseLayout>

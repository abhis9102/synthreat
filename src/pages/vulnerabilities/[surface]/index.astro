---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { VULN_SURFACES } from '../../../content.config';

const surfaceSlug = (surface: string) => surface.toLowerCase().replace(/\s+/g, '-');

export async function getStaticPaths() {
  const entries = await getCollection('vulnerabilities', ({ data }) => data.status === 'published');
  return VULN_SURFACES.map((surface) => ({
    params: { surface: surface.toLowerCase().replace(/\s+/g, '-') },
    props: {
      surface,
      entries: entries
        .filter((entry) => entry.data.surface === surface)
        .sort((a, b) => a.data.title.localeCompare(b.data.title)),
    },
  })).filter((path) => path.props.entries.length > 0);
}

interface Props {
  surface: (typeof VULN_SURFACES)[number];
  entries: Awaited<ReturnType<typeof getCollection<'vulnerabilities'>>>;
}
const { surface, entries } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

// Cap on how many OWASP categories show before a "View all" toggle takes over, matching the
// homepage's own 4-card-cap-then-reveal pattern. Only meaningful for WebApp Security, the one
// surface large enough to need this second level of grouping (see content.config.ts).
const CATEGORY_CAP = 4;

let subgroups: { code: string; label: string; entries: typeof entries }[] | null = null;
if (surface === 'WebApp Security') {
  const byCode = new Map<string, { code: string; label: string; entries: typeof entries }>();
  for (const entry of entries) {
    const code = entry.data.owasp?.match(/^A\d{2}/)?.[0] ?? 'Other';
    if (!byCode.has(code)) byCode.set(code, { code, label: entry.data.owasp ?? 'Other', entries: [] });
    byCode.get(code)!.entries.push(entry);
  }
  subgroups = [...byCode.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([, v]) => v);
}

const SURFACE_INTROS: Record<(typeof VULN_SURFACES)[number], string> = {
  'Cloud Security': "The misconfigurations that cause most real cloud incidents: an access setting, an identity permission, or a template left wrong, rather than a coding bug.",
  'WebApp Security': "The OWASP Top 10 (2021), grouped by its own official categories, plus the specific classes (IDOR, CSRF, path traversal, and others) that specialize each one.",
  'Mobile Security': "What's different about testing an app that ships its own compiled code onto a device the attacker fully controls.",
  'Network Security': "The building blocks of a network that actually contains a compromise instead of handing an attacker everything at once.",
  'AI Security': "The full OWASP Top 10 for LLM Applications, the standard, practitioner-focused list of what goes wrong in production AI systems.",
};
---

<BaseLayout
  wide
  title={`${surface} Vulnerabilities`}
  description={SURFACE_INTROS[surface]}
>
  <a class="tagline" href={`${base}vulnerabilities/`}>← Vulnerability Classes</a>
  <h1>{surface}</h1>
  <p style="font-size:18px;color:var(--ink-soft);margin-top:14px;max-width:70ch;">{SURFACE_INTROS[surface]}</p>

  {subgroups ? (
    <>
      <div style="margin-top:36px;display:flex;flex-direction:column;gap:32px;">
        {subgroups.slice(0, CATEGORY_CAP).map((sub) => (
          <div id={sub.code.toLowerCase()}>
            <div class="subgroup-label">{sub.label}</div>
            <div class="card-grid" style="margin-top:12px;">
              {sub.entries.map((entry) => (
                <a href={`${base}vulnerabilities/${entry.id}/`} class="card">
                  <span class="badge">Ceiling: {entry.data.typicalSeverityCeiling}</span>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.summary}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
      {subgroups.length > CATEGORY_CAP && (
        <details class="view-all-toggle" style="margin-top:32px;">
          <summary>View all {subgroups.length} OWASP Top 10 categories →</summary>
          <div style="margin-top:20px;display:flex;flex-direction:column;gap:32px;">
            {subgroups.slice(CATEGORY_CAP).map((sub) => (
              <div id={sub.code.toLowerCase()}>
                <div class="subgroup-label">{sub.label}</div>
                <div class="card-grid" style="margin-top:12px;">
                  {sub.entries.map((entry) => (
                    <a href={`${base}vulnerabilities/${entry.id}/`} class="card">
                      <span class="badge">Ceiling: {entry.data.typicalSeverityCeiling}</span>
                      <h3>{entry.data.title}</h3>
                      <p>{entry.data.summary}</p>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </details>
      )}
    </>
  ) : (
    <div class="card-grid" style="margin-top:36px;">
      {entries.map((entry) => (
        <a href={`${base}vulnerabilities/${entry.id}/`} class="card">
          <span class="badge">Ceiling: {entry.data.typicalSeverityCeiling}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary}</p>
        </a>
      ))}
    </div>
  )}
</BaseLayout>

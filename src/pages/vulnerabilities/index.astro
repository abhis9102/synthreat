---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { VULN_SURFACES } from '../../content.config';

const entries = await getCollection('vulnerabilities', ({ data }) => data.status === 'published');
const base = import.meta.env.BASE_URL;

const surfaceSlug = (surface: string) => surface.toLowerCase().replace(/\s+/g, '-');

const SURFACE_BLURBS: Record<(typeof VULN_SURFACES)[number], string> = {
  'Cloud Security': 'Public storage exposure, IAM misconfiguration, insecure IaC, and the other failure modes unique to renting infrastructure.',
  'WebApp Security': 'The OWASP Top 10: injection, broken access control, and everything else a browser-facing app can get wrong.',
  'MobileApp Security': "What's structurally different about securing an app that ships its own compiled code onto a device the user controls.",
  'Network Security': "Segmentation, access control, wireless, and the building blocks of a network an attacker can't freely move across.",
  'AI Security': 'The OWASP Top 10 for LLM Applications: prompt injection, excessive agency, and the risks specific to AI-powered systems.',
};

// This page is a landing page, not a flat list: each surface (mirroring the domains collection's
// own surface names) gets its own dedicated listing page at /vulnerabilities/<surface>/
// (src/pages/vulnerabilities/[surface]/index.astro), the same way the homepage points at each
// top-level collection's own index rather than trying to list everything in one place.
const surfaces = VULN_SURFACES.map((surface) => ({
  surface,
  count: entries.filter((entry) => entry.data.surface === surface).length,
})).filter((s) => s.count > 0);
---

<BaseLayout
  wide
  title="Vulnerability Classes"
  description="Deep, evidence-based writeups of vulnerability classes, organized by surface, with technical and business impact together on every page."
>
  <span class="tagline">Index</span>
  <h1>Vulnerability Classes</h1>
  <p style="font-size:18px;color:var(--ink-soft);margin-top:14px;max-width:70ch;">
    Every page here follows the same locked structure: what it is, why the trust that enables it
    fails, where it actually shows up, how to find it, what it costs a real business, and how it gets
    fixed. Written for a newcomer and a client-facing security person to read the same page and both
    get what they need. Pick a surface below to see its full list.
  </p>

  <div class="card-grid" style="margin-top:36px;">
    {surfaces.map(({ surface, count }) => (
      <a href={`${base}vulnerabilities/${surfaceSlug(surface)}/`} class="card">
        <span class="badge">{count} {count === 1 ? 'page' : 'pages'}</span>
        <h3>{surface}</h3>
        <p>{SURFACE_BLURBS[surface]}</p>
      </a>
    ))}
    {surfaces.length === 0 && (
      <p style="color:var(--ink-faint);">Nothing published yet. Check back soon.</p>
    )}
  </div>
</BaseLayout>

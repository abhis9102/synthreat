---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionOverview from '../../components/CollectionOverview.astro';

const entries = (await getCollection('vulnerabilities', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  wide
  title="Vulnerability Classes"
  description="Deep, evidence-based writeups of vulnerability classes — technical and business impact, together, on every page."
>
  <span class="tagline">Index</span>
  <h1>Vulnerability Classes</h1>
  <p style="font-size:17px;color:var(--ink-soft);margin-top:14px;max-width:70ch;">
    Every page here follows the same locked structure: what it is, why the trust that enables it
    fails, where it actually shows up, how to find it, what it costs a real business, and how it gets
    fixed. Written for a newcomer and a client-facing security person to read the same page and both
    get what they need.
  </p>

  <CollectionOverview kind="vulnerabilities" entries={entries} />

  <div class="card-grid" style="margin-top:36px;">
    {entries.map((entry) => (
      <a href={`${base}vulnerabilities/${entry.id}/`} class="card">
        <span class="badge">Ceiling: {entry.data.typicalSeverityCeiling}</span>
        <h3>{entry.data.title}</h3>
        <p>{entry.data.summary}</p>
      </a>
    ))}
    {entries.length === 0 && (
      <p style="color:var(--ink-faint);">Nothing published yet — check back soon.</p>
    )}
  </div>
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuizBlock from '../../components/QuizBlock.astro';
import PathLessonNav from '../../components/PathLessonNav.astro';

export async function getStaticPaths() {
  const entries = await getCollection('attacks', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, capec, mitreAttack, typicalSeverityCeiling } = entry.data;
const base = import.meta.env.BASE_URL;

// CAPEC and ATT&CK IDs cite a real, publicly maintained catalog entry, so the chip links straight
// to MITRE's own page for that specific ID rather than sitting as unlinked text. Both follow
// stable, well-established URL conventions: CAPEC-98 -> capec.mitre.org/data/definitions/98.html,
// and a sub-technique like T1566.001 splits into a separate path segment
// (attack.mitre.org/techniques/T1566/001/), not a literal dot.
const capecUrl = (id: string) => `https://capec.mitre.org/data/definitions/${id.replace(/^CAPEC-/, '')}.html`;
const attackUrl = (id: string) => `https://attack.mitre.org/techniques/${id.replace('.', '/')}/`;
---

<BaseLayout title={title} description={summary}>
  <a class="tagline" href={`${base}attacks/`}>← Attack technique</a>
  <h1>{title}</h1>
  <p style="font-size:18px;color:var(--ink-soft);margin-top:14px;">{summary}</p>
  <div class="vuln-meta">
    <span class="chip severity">Typical ceiling: {typicalSeverityCeiling}</span>
    {capec.map((id: string) => (
      <a class="chip" href={capecUrl(id)} target="_blank" rel="noopener">{id}</a>
    ))}
    {mitreAttack.map((id: string) => (
      <a class="chip" href={attackUrl(id)} target="_blank" rel="noopener">ATT&amp;CK {id}</a>
    ))}
  </div>
  <div class="vuln-actions">
    <a
      class="btn btn-secondary ai-ask-btn"
      href={`${base}assistant/?q=${encodeURIComponent(`Explain ${title} attack mechanics and how to build a defense talk track for executives`)}`}
      data-ai-prompt={`Explain ${title} attack mechanics and how to build a defense talk track for executives`}
      data-topic={title}
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Ask Synthreat AI about {title} ✦
    </a>
  </div>
  <article class="vuln-body">
    <Content />
  </article>
  <PathLessonNav col="attacks" slug={entry.id} />
  <QuizBlock articleSlug={entry.id} />
</BaseLayout>

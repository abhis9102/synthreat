<script>
  import { marked } from 'marked';

  // State
  let knowledgeIndex: any[] = [];
  let currentMode = 'dual'; // 'dual' | 'technical' | 'business'
  let isGenerating = false;
  let conversationHistory: Array<{ role: string; parts: Array<any> }> = [];

  interface AttachedFile {
    name: string;
    size: string;
    type: 'image' | 'pdf' | 'text';
    mimeType?: string;
    data?: string;
    dataUrl?: string;
    textContent?: string;
  }

  interface SavedChatTurn {
    id?: string;
    userQuery: string;
    assistantText: string;
    intent: string;
    matchedArticles: any[];
    mode: string;
    attachment?: {
      name: string;
      size: string;
      type: 'image' | 'pdf' | 'text';
      dataUrl?: string;
    };
  }
  let savedChatTurns: SavedChatTurn[] = [];
  let currentAttachment: AttachedFile | null = null;

  const container = document.querySelector('.assistant-container') as HTMLElement;
  const base = container?.dataset.base || '/synthreat/';
  const defaultKey = container?.dataset.defaultKey || '';

  // Get active key: localStorage or default from .env
  function getActiveApiKey(): string {
    const stored = localStorage.getItem('synthreat_gemini_key');
    if (stored && stored.trim()) return stored.trim();
    return defaultKey;
  }

  function getActiveModel(): string {
    return localStorage.getItem('synthreat_gemini_model') || 'gemini-3.5-flash-lite';
  }

  // Update Status Pill
  function updateKeyStatusUI() {
    const key = getActiveApiKey();
    const statusLabel = document.getElementById('keyStatusLabel');
    const indicator = document.querySelector('.status-indicator');
    const model = getActiveModel();

    if (key) {
      if (statusLabel) statusLabel.textContent = `Connected (${model.replace('gemini-', '')})`;
      indicator?.classList.remove('error');
    } else {
      if (statusLabel) statusLabel.textContent = 'Setup API Key';
      indicator?.classList.add('error');
    }
  }

  function isConversational(query: string): boolean {
    const q = query.toLowerCase().trim().replace(/[^a-z0-9\s]/g, '');
    if (!q) return true;
    const conversationalTokens = new Set([
      'hi', 'hello', 'hey', 'greetings', 'howdy', 'hlow', 'hola',
      'test', 'testing', 'ping',
      'yes', 'no', 'es', 'ok', 'okay', 'sure', 'yep', 'yeah', 'cool',
      'thanks', 'thank', 'you', 'got', 'it', 'thx',
      'who', 'are', 'you', 'what', 'can', 'do', 'help'
    ]);
    const words = q.split(/\s+/);
    return words.length <= 3 && words.every(w => conversationalTokens.has(w));
  }

  // Fast System 1 Intent Classifier (<1ms heuristic detection)
  function detectIntent(query: string): string {
    const q = query.toLowerCase().trim();
    if (isConversational(q)) {
      if (/^(hi|hello|hey|greetings|howdy|hlow|hola)\b/i.test(q)) return '👋 Greeting';
      if (/^(test|testing|ping)\b/i.test(q)) return '🧪 System Test';
      if (/^(yes|no|es|ok|okay|sure|yep|yeah|cool|got it)\b/i.test(q)) return '💬 Follow-up';
      if (/^(thanks|thank you|thx)\b/i.test(q)) return '🙏 Acknowledgement';
      return '💬 General Chat';
    }
    if (q.includes('cfo') || q.includes('executive') || q.includes('client') || q.includes('board') || q.includes('talk track') || q.includes('stakeholder') || q.includes('business')) {
      return '💼 Executive & Client Framing';
    }
    if (q.includes('cvss') || q.includes('severity') || q.includes('critical') || q.includes('calibrate') || q.includes('rating') || q.includes('score')) {
      return '📊 Severity Calibration';
    }
    if (q.includes('soc 2') || q.includes('iso') || q.includes('gdpr') || q.includes('hipaa') || q.includes('pci') || q.includes('compliance') || q.includes('regulation') || q.includes('audit')) {
      return '⚖️ Compliance & Governance';
    }
    if (q.includes('fix') || q.includes('patch') || q.includes('remediation') || q.includes('code') || q.includes('bypass') || q.includes('orm') || q.includes('boundary')) {
      return '🛠️ Technical Remediation';
    }
    if (q.includes('llm') || q.includes('prompt injection') || q.includes('rag') || q.includes('ai security') || q.includes('jailbreak')) {
      return '🤖 AI & LLM Security';
    }
    if (q.includes('diff') || q.includes('difference') || q.includes('compare') || q.includes('versus') || q.includes('vs')) {
      return '⚖️ Comparison & Analysis';
    }
    if (q.includes('detect') || q.includes('scanner') || q.includes('tool') || q.includes('find') || q.includes('scan')) {
      return '🔍 Detection & Verification';
    }
    return '🛡️ Cybersecurity Guidance';
  }

  // Dynamic Follow-up Suggestions
  function generateFollowups(query: string, matchedArticles: any[]): string[] {
    if (isConversational(query)) return [];
    if (!matchedArticles || matchedArticles.length === 0) return [];
    const q = query.toLowerCase();
    const suggestions: string[] = [];

    if (matchedArticles.length > 0) {
      const topTitle = matchedArticles[0].title;
      suggestions.push(`What is the common flawed remediation people ship for ${topTitle}?`);
      suggestions.push(`How do I frame the ROI of fixing ${topTitle} to leadership?`);
    }

    if (q.includes('sql') || q.includes('injection')) {
      suggestions.push('How do parameterized queries prevent SQLi under the hood?');
      suggestions.push('What regulatory fines (GDPR/SEC) apply to SQLi data leaks?');
    } else if (q.includes('ssrf')) {
      suggestions.push('How does AWS IMDSv2 protect against SSRF?');
      suggestions.push('Why do regex URL blocklists fail against DNS rebinding?');
    } else if (q.includes('idor') || q.includes('access control')) {
      suggestions.push('How does BOLA differ from IDOR in API security?');
      suggestions.push('Can automated scanners reliably detect IDOR findings?');
    } else if (q.includes('soc 2') || q.includes('compliance')) {
      suggestions.push('Why does a clean SOC 2 report not guarantee zero security breaches?');
      suggestions.push('How should a sales engineer explain SOC 2 vs ISO 27001 to a client?');
    }

    return suggestions.slice(0, 3);
  }


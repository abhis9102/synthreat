  function saveChatState() {
    try {
      // Strip raw base64 dataUrl from attachments — it can easily exhaust the 5MB localStorage quota.
      // We keep name/size/type so the badge still renders after restore.
      const slim = savedChatTurns.map(t => ({
        ...t,
        attachment: t.attachment ? { name: t.attachment.name, size: t.attachment.size, type: t.attachment.type } : undefined
      }));
      localStorage.setItem('synthreat_active_chat_turns', JSON.stringify(slim));
      localStorage.setItem('synthreat_active_chat_gemini', JSON.stringify(conversationHistory));
    } catch (e: any) {
      if (e?.name === 'QuotaExceededError') {
        // Fallback: keep only the last 20 turns
        try {
          const slim = savedChatTurns.slice(-20).map(t => ({
            ...t,
            attachment: t.attachment ? { name: t.attachment.name, size: t.attachment.size, type: t.attachment.type } : undefined
          }));
          localStorage.setItem('synthreat_active_chat_turns', JSON.stringify(slim));
          localStorage.setItem('synthreat_active_chat_gemini', JSON.stringify(conversationHistory.slice(-40)));
        } catch {}
      } else {
        console.warn('Could not save chat state to localStorage', e);
      }
    }
  }


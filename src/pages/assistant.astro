---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
// Read default server/dev key if available in .env
const defaultKey = process.env.GEMINI_API_KEY || import.meta.env.GEMINI_API_KEY || '';
---

<BaseLayout
  wide
  title="Synthreat AI · Dual Perspective Cybersecurity Intelligence"
  description="Evidence-based cybersecurity guidance AI Assistant. Every response bridges the gap between technical mechanics and business reality."
>
  <div class="assistant-container" data-base={base} data-has-default-key={defaultKey ? 'true' : 'false'} data-default-key={defaultKey}>
    <header class="assistant-header">
      <div class="header-content">
        <div class="header-badge">
          <span class="pulse-dot"></span>
          <span>Gemini-Powered Intelligence</span>
        </div>
        <h1 class="assistant-title">
          Synthreat <span class="accent-text">AI</span>
        </h1>
        <p class="assistant-subtitle">
          Evidence-based cybersecurity guidance AI Assistant. Every response bridges the gap between <strong>technical mechanics</strong> and <strong>business reality</strong>.
        </p>
      </div>

      <div class="assistant-controls">
        <!-- Perspective Switcher -->
        <div class="perspective-picker" role="radiogroup" aria-label="Audience Lens">
          <button type="button" class="perspective-btn active" data-mode="dual" title="Both Technical Deep-Dive and Business Translation">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
            <span>Dual Perspective</span>
          </button>
          <button type="button" class="perspective-btn" data-mode="technical" title="Technical mechanics, trust boundaries, and remediation">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg>
            <span>Technical Deep-Dive</span>
          </button>
          <button type="button" class="perspective-btn" data-mode="business" title="Risk exposure, financial impact, and client conversation framing">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <span>Executive / Client</span>
          </button>
        </div>

        <button type="button" id="headerUploadBtn" class="header-action-btn" title="Upload Document or Screenshot (PDF, Word, Code, Image)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
          <span>Upload File</span>
        </button>

        <button type="button" id="clearChatHeaderBtn" class="clear-header-btn" title="Clear entire conversation" style="display:none;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          <span>Clear Chat</span>
        </button>

        <button type="button" id="settingsBtn" class="settings-pill" aria-label="Assistant settings and API configuration">
          <span class="status-indicator"></span>
          <span id="keyStatusLabel">Checking API...</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </button>
      </div>
    </header>

    <!-- Starters / Prompt Suggestions -->
    <div id="startersContainer" class="starters-section">
      <div class="starters-label">Suggested prompt starters:</div>
      <div class="starters-grid">
        <button type="button" class="starter-card starter-card-upload" id="uploadStarterCard">
          <span class="starter-tag upload-tag">📎 Multimodal Security Review</span>
          <span class="starter-text">"Upload a PDF report, Word doc, code file, or screenshot for AI analysis"</span>
        </button>
        <button type="button" class="starter-card" data-prompt="How do I explain SQL Injection to a CFO without sounding alarmist, and what does it actually cost a company?">
          <span class="starter-tag">Executive Translation</span>
          <span class="starter-text">"Explain SQL Injection to a CFO without fear-mongering"</span>
        </button>
        <button type="button" class="starter-card" data-prompt="What trust boundary actually fails in Server-Side Request Forgery (SSRF), and why do regex URL blocklists consistently fail?">
          <span class="starter-tag">Technical Mechanics</span>
          <span class="starter-text">"What trust boundary breaks in SSRF & why blocklists fail"</span>
        </button>
        <button type="button" class="starter-card" data-prompt="Why does holding a SOC 2 Type II certification not prevent ransomware, and how do I explain this distinction to our risk committee?">
          <span class="starter-tag">Compliance vs Reality</span>
          <span class="starter-text">"Why SOC 2 does not stop ransomware & how to frame it"</span>
        </button>
        <button type="button" class="starter-card" data-prompt="We found an IDOR where any authenticated tenant can download another customer's invoices by incrementing an invoice_id. How do we calibrate its CVSS severity and communicate this finding?">
          <span class="starter-tag">Severity Calibration</span>
          <span class="starter-text">"Calibrate severity for IDOR on invoice export endpoint"</span>
        </button>
        <button type="button" class="starter-card" data-prompt="Explain Prompt Injection vs Insecure Output Handling in LLM applications according to the OWASP Top 10 for LLMs, with realistic attack scenarios.">
          <span class="starter-tag">AI Security</span>
          <span class="starter-text">"Prompt Injection vs Insecure Output in LLM security"</span>
        </button>
      </div>
    </div>

    <!-- Chat Messages Display -->
    <div class="chat-thread" id="chatThread" aria-live="polite">
      <!-- Dynamic turns appended here -->
    </div>

    <!-- Floating Jump to Latest Button -->
    <div class="jump-bottom-wrapper" data-visible="false">
      <button type="button" id="jumpToBottomBtn" class="jump-bottom-btn" title="Jump to latest message">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
        <span>Jump to latest message</span>
      </button>
    </div>

    <!-- Input Box -->
    <div class="input-panel">
      <form id="chatForm" class="input-form">
        <div id="filePreviewBar" class="ai-file-preview-bar" style="display:none;"></div>
        <div class="input-wrapper">
          <button type="button" id="attachFileBtn" class="icon-action-btn attach-btn" title="Attach file (PDF, TXT, Word, Image)" aria-label="Attach file">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
            <span class="attach-btn-label">Attach</span>
          </button>
          <input type="file" id="fileInput" accept=".txt,.md,.json,.csv,.log,.py,.js,.ts,.pdf,.docx,.doc,.jpg,.jpeg,.png,.webp,text/*,image/*,application/pdf" style="display:none;" />
          <textarea
            id="promptInput"
            rows="1"
            placeholder="Ask a technical security question, upload a document or screenshot, or paste a finding..."
            aria-label="Your question"
          ></textarea>
          <div class="input-actions">
            <button type="button" id="clearBtn" class="icon-action-btn" title="Clear conversation" style="display:none;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
            <button type="submit" id="sendBtn" class="send-btn" aria-label="Send message">
              <span class="btn-text">Send</span>
              <svg class="send-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
              <span class="spinner" style="display:none;"></span>
            </button>
          </div>
        </div>
        <div class="input-hints-bar">
          <span class="hint-pill">Supported Formats</span>
          <span>Images (JPEG, PNG, WebP) • PDF • Word (.docx) • Code & Logs up to 10MB • Drag & drop or paste (Ctrl+V)</span>
        </div>
      </form>
    </div>

    <!-- Drag & Drop Visual Overlay -->
    <div id="dragDropOverlay" class="drag-drop-overlay" style="display:none;">
      <div class="drag-drop-card">
        <div class="drag-drop-icon">📁</div>
        <div class="drag-drop-title">Drop file to attach to Synthreat AI</div>
        <div class="drag-drop-sub">PDF, Word (.docx), Text, Source Code, and Images up to 10MB</div>
      </div>
    </div>

    <!-- Settings Modal -->
    <dialog id="settingsDialog" class="settings-modal">
      <div class="modal-box">
        <div class="modal-header">
          <h3>Assistant Configuration</h3>
          <button type="button" id="closeSettingsBtn" class="modal-close" aria-label="Close dialog">&times;</button>
        </div>
        <div class="modal-body">
          <div class="form-group">
            <label for="apiKeyInput">Gemini API Key</label>
            <input
              type="password"
              id="apiKeyInput"
              placeholder="Paste your Gemini API key (AQ... or AIza...)"
              autocomplete="off"
            />
            <p class="field-hint">
              Stored exclusively in your browser's <code>localStorage</code>. Never sent to any server other than Google's official Gemini endpoint.
            </p>
            <div class="key-help">
              Don't have a key? <a href="https://aistudio.google.com/" target="_blank" rel="noopener">Get a free Gemini API key from Google AI Studio →</a>
            </div>
          </div>

          <div class="form-group">
            <label for="modelSelect">Model Selection</label>
            <select id="modelSelect">
              <option value="gemini-3.5-flash-lite" selected>Gemini 3.5 Flash-Lite (Recommended — Ultra Fast & Reliable)</option>
              <option value="gemini-3.8-flash">Gemini 3.8 Flash</option>
              <option value="gemini-3.7-flash">Gemini 3.7 Flash</option>
              <option value="gemini-flash-latest">Gemini Flash Latest</option>
            </select>
          </div>

          <div class="form-group">
            <label>Active Knowledge Index</label>
            <div id="indexStats" class="stats-badge">Loading 114 articles index...</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" id="resetKeyBtn" class="btn btn-secondary">Reset to Default</button>
          <button type="button" id="saveSettingsBtn" class="btn btn-primary">Save & Apply</button>
        </div>
      </div>
    </dialog>
  </div>
</BaseLayout>

<style>
  .assistant-container {
    max-width: 1060px;
    margin: 0 auto;
    padding: 10px 0 60px 0;
  }

  .assistant-header {
    border-bottom: 1px solid var(--line);
    padding-bottom: 24px;
    margin-bottom: 24px;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(196, 73, 29, 0.7);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(196, 73, 29, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(196, 73, 29, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(196, 73, 29, 0); }
  }

  .assistant-title {
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.15;
    margin-bottom: 8px;
  }

  .assistant-subtitle {
    color: var(--ink-soft);
    font-size: 17px;
    max-width: 76ch;
    margin: 0 0 20px 0;
  }

  .assistant-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .perspective-picker {
    display: inline-flex;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 3px;
    gap: 3px;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .perspective-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: 7px;
    border: none;
    background: transparent;
    color: var(--ink-soft);
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .perspective-btn:hover {
    color: var(--ink);
  }

  .perspective-btn.active {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 2px 8px -2px rgba(196, 73, 29, 0.4);
  }

  .clear-header-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .clear-header-btn:hover {
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.4);
    background: var(--surface-2);
  }

  .header-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .header-action-btn:hover {
    color: var(--accent);
    border-color: var(--accent-soft-line);
    background: var(--surface-2);
  }

  .settings-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .settings-pill:hover {
    color: var(--ink);
    border-color: var(--accent-soft-line);
    background: var(--surface-2);
  }

  .status-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
  }

  .status-indicator.error {
    background: #ef4444;
  }

  /* Starters */
  .starters-section {
    margin-bottom: 28px;
  }

  .starters-label {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 10px;
  }

  .starters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 10px;
  }

  .starter-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    text-align: left;
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .starter-card:hover {
    border-color: var(--accent-soft-line);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .starter-card-upload {
    border: 1.5px dashed var(--accent-soft-line);
    background: color-mix(in srgb, var(--accent-soft) 30%, var(--surface));
  }

  .starter-card-upload:hover {
    border-color: var(--accent);
    background: var(--surface);
  }

  .upload-tag {
    color: var(--accent-ink);
    background: var(--accent-soft);
    border: 1px solid var(--accent-soft-line);
    padding: 2px 7px;
    border-radius: 5px;
    display: inline-block;
  }

  .starter-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .starter-text {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
  }

  /* Chat thread */
  .chat-thread {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 30px;
    min-height: 100px;
  }

  :global(.message-turn) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(.user-turn) {
    align-self: flex-end;
    max-width: 85%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  :global(.user-bubble-container) {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    max-width: 100%;
  }

  :global(.user-bubble) {
    background: var(--accent);
    color: #fff;
    padding: 12px 18px;
    border-radius: 14px 14px 2px 14px;
    font-size: 15.5px;
    line-height: 1.5;
    font-weight: 500;
    word-break: break-word;
  }

  :global(.user-turn-actions) {
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0.85;
    transition: opacity 0.15s ease;
  }

  :global(.user-turn:hover .user-turn-actions) {
    opacity: 1;
  }

  :global(.user-action-btn) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
    font-family: inherit;
    font-size: 11.5px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  :global(.user-action-btn:hover) {
    color: var(--ink);
    border-color: var(--accent-soft-line);
    background: var(--surface-2);
  }

  :global(.user-action-btn.delete-turn-btn:hover) {
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.4);
  }

  /* Inline editing box */
  :global(.user-edit-container) {
    width: 100%;
    min-width: 320px;
    max-width: 620px;
    background: var(--surface);
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 12px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.user-edit-textarea) {
    width: 100%;
    background: transparent;
    border: none;
    color: var(--ink);
    font-family: inherit;
    font-size: 14.5px;
    line-height: 1.5;
    resize: vertical;
    outline: none;
    min-height: 54px;
  }

  :global(.user-edit-actions) {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 4px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }

  :global(.user-edit-cancel-btn) {
    padding: 5px 12px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--ink-soft);
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  :global(.user-edit-cancel-btn:hover) {
    color: var(--ink);
    background: var(--surface);
  }

  :global(.user-edit-save-btn) {
    padding: 5px 14px;
    border-radius: 6px;
    border: none;
    background: var(--accent);
    color: #fff;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  :global(.user-edit-save-btn:hover) {
    opacity: 0.9;
  }

  :global(.assistant-turn) {
    align-self: stretch;
  }

  :global(.assistant-card-wrapper) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  :global(.assistant-card-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    color: var(--ink-soft);
    gap: 8px;
    flex-wrap: wrap;
  }

  :global(.header-left) {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  :global(.header-right) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  :global(.card-delete-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-faint);
    cursor: pointer;

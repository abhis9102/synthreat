  function restoreChatState(): boolean {
    try {
      const rawTurns = localStorage.getItem('synthreat_active_chat_turns');
      const rawGemini = localStorage.getItem('synthreat_active_chat_gemini');
      if (!rawTurns) return false;
      const parsedTurns = JSON.parse(rawTurns);
      if (!Array.isArray(parsedTurns) || parsedTurns.length === 0) return false;

      savedChatTurns = parsedTurns;
      if (rawGemini) {
        try { conversationHistory = JSON.parse(rawGemini); } catch {}
      }

      document.getElementById('startersContainer')?.setAttribute('style', 'display:none;');
      updateClearButtonsVisibility(true);

      const thread = document.getElementById('chatThread');
      if (thread) thread.innerHTML = '';

      for (const turn of savedChatTurns) {
        if (!turn.id) {
          turn.id = 'turn_' + Math.random().toString(36).slice(2, 9);
        }
        renderCompletedTurn(turn);
      }
      saveChatState();
      checkJumpButtonVisibility();
      return true;
    } catch (e) {
      console.warn('Failed to restore chat state:', e);
      return false;
    }
  }

  // Scroll and Jump Button Handlers
  const jumpWrapper = document.querySelector('.jump-bottom-wrapper') as HTMLElement;
  const jumpBtn = document.getElementById('jumpToBottomBtn');

  function checkJumpButtonVisibility() {
    if (!jumpWrapper) return;
    const thread = document.getElementById('chatThread');
    if (!thread || thread.children.length === 0) {
      jumpWrapper.setAttribute('data-visible', 'false');
      return;
    }
    const distFromBottom = document.documentElement.scrollHeight - (window.scrollY + window.innerHeight);
    if (distFromBottom > 320) {
      jumpWrapper.setAttribute('data-visible', 'true');
    } else {
      jumpWrapper.setAttribute('data-visible', 'false');
    }
  }

  window.addEventListener('scroll', checkJumpButtonVisibility, { passive: true });

  jumpBtn?.addEventListener('click', () => {
    const thread = document.getElementById('chatThread');
    const lastTurn = thread?.lastElementChild;
    if (lastTurn) {
      lastTurn.scrollIntoView({ behavior: 'smooth', block: 'end' });
    } else {
      const inputPanel = document.querySelector('.input-panel');
      inputPanel?.scrollIntoView({ behavior: 'smooth', block: 'end' });
    }
  });

  function autoScrollDuringStream() {
    const distFromBottom = document.documentElement.scrollHeight - (window.scrollY + window.innerHeight);
    // Auto-scroll only if user is actively tracking near the bottom (< 280px away)
    if (distFromBottom < 280) {
      window.scrollTo({
        top: document.documentElement.scrollHeight,
        behavior: 'smooth'
      });
    }
  }


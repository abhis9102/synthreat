    'please', 'tell', 'show', 'give', 'detail', 'details'
  ]);

  // Grounding Search: Token matching against Synthreat articles
  function findRelevantArticles(query: string, topN = 3) {
    if (isConversational(query)) return [];
    if (!knowledgeIndex || knowledgeIndex.length === 0) return [];

    const queryClean = query.toLowerCase().replace(/[^a-z0-9\s]/g, ' ');
    const queryTokens = queryClean.split(/\s+/).filter(t => t.length > 2 && !GROUNDING_STOPWORDS.has(t));
    if (queryTokens.length === 0) return [];

    const scored = knowledgeIndex.map(entry => {
      let score = 0;
      const titleLower = (entry.title || '').toLowerCase();
      const slugLower = (entry.slug || '').toLowerCase();
      const techLower = (entry.tech || '').toLowerCase();
      const bizLower = (entry.biz || '').toLowerCase();
      const summaryLower = (entry.summary || '').toLowerCase();

      for (const token of queryTokens) {
        if (titleLower.includes(token)) score += 15;
        if (slugLower.includes(token)) score += 12;
        if (summaryLower.includes(token)) score += 5;
        if (techLower.includes(token)) score += 3;
        if (bizLower.includes(token)) score += 3;
      }

      // Exact or partial title phrase match bonus
      if (queryClean.includes(titleLower) || (titleLower.length > 6 && queryClean.includes(titleLower.slice(0, 15)))) {
        score += 35;
      }

      return { entry, score };
    });

    const candidates = scored.filter(item => item.score >= 15).sort((a, b) => b.score - a.score);
    if (!candidates.length) return [];

    const topScore = candidates[0].score;
    return candidates
      .filter(item => item.score >= Math.max(15, topScore * 0.4))
      .slice(0, topN)
      .map(item => item.entry);
  }


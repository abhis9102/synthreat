  const GROUNDING_STOPWORDS = new Set([
    'explain', 'what', 'how', 'why', 'can', 'does', 'with', 'for', 'from', 'about',
    'into', 'that', 'this', 'business', 'impact', 'mechanics', 'technical', 'non',
    'stakeholders', 'executive', 'translate', 'guidance', 'perspective', 'analysis',
    'overview', 'summary', 'difference', 'diff', 'versus', 'vs', 'vulnerability',

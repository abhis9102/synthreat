  function deleteTurn(turnId: string) {
    const turnIndex = savedChatTurns.findIndex(t => t.id === turnId);
    if (turnIndex !== -1) {
      savedChatTurns.splice(turnIndex, 1);
      conversationHistory = savedChatTurns.flatMap(t => [
        { role: 'user', parts: [{ text: t.userQuery }] },
        { role: 'model', parts: [{ text: t.assistantText }] }
      ]);
      saveChatState();
    }

    document.querySelectorAll(`[data-turn-id="${turnId}"]`).forEach(el => el.remove());

    if (savedChatTurns.length === 0) {
      document.getElementById('startersContainer')?.removeAttribute('style');
      updateClearButtonsVisibility(false);
    } else {
      updateClearButtonsVisibility(true);
    }
    checkJumpButtonVisibility();
  }

  function editAndResubmitTurn(turnId: string, newQuery: string) {
    if (isGenerating) return;
    const turnIndex = savedChatTurns.findIndex(t => t.id === turnId);
    if (turnIndex === -1) {
      submitPrompt(newQuery);
      return;
    }

    const turnsToRemove = savedChatTurns.slice(turnIndex);
    savedChatTurns = savedChatTurns.slice(0, turnIndex);
    conversationHistory = savedChatTurns.flatMap(t => [
      { role: 'user', parts: [{ text: t.userQuery }] },
      { role: 'model', parts: [{ text: t.assistantText }] }
    ]);
    saveChatState();

    for (const t of turnsToRemove) {
      if (t.id) {
        document.querySelectorAll(`[data-turn-id="${t.id}"]`).forEach(el => el.remove());
      }
    }

    submitPrompt(newQuery);
  }


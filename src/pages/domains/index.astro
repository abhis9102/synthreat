---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('domains', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  wide
  title="Domains"
  description="Plain-language explainers for whole fields of security practice, like application, cloud, and mobile security — technical and business impact, together, on every page."
>
  <span class="tagline">Index</span>
  <h1>Domains</h1>
  <p style="font-size:17px;color:var(--ink-soft);margin-top:14px;max-width:70ch;">
    Whole fields of security practice: what makes application security different from cloud
    security, why mobile has its own threat model. For how security is actually tested, see
    <a href={`${base}methodology/`}>Methodology</a>; for named standards and compliance regimes, see
    <a href={`${base}frameworks/`}>Frameworks</a> and <a href={`${base}compliance/`}>Compliance</a>.
  </p>

  <div class="card-grid" style="margin-top:36px;">
    {entries.map((entry) => (
      <a href={`${base}domains/${entry.id}/`} class="card">
        <span class="badge">{entry.data.category}</span>
        <h3>{entry.data.title}</h3>
        <p>{entry.data.summary}</p>
      </a>
    ))}
    {entries.length === 0 && (
      <p style="color:var(--ink-faint);">Nothing published yet — check back soon.</p>
    )}
  </div>
</BaseLayout>

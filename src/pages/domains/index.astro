---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('domains', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  wide
  title="Domains & Concepts"
  description="Plain-language explainers for cybersecurity domains, methodologies, and service models — technical and business impact, together, on every page."
>
  <span class="tagline">Index</span>
  <h1>Domains &amp; Concepts</h1>
  <p style="font-size:17px;color:var(--ink-soft);margin-top:14px;max-width:70ch;">
    The bigger picture around vulnerability classes: what penetration testing actually is, how
    security domains like application and cloud security fit together, and the methodologies and
    service models behind them. Written assuming zero prior knowledge, with a dedicated section on
    every page for explaining it to a client.
  </p>

  <div class="card-grid" style="margin-top:36px;">
    {entries.map((entry) => (
      <a href={`${base}domains/${entry.id}/`} class="card">
        <span class="badge">{entry.data.category}</span>
        <h3>{entry.data.title}</h3>
        <p>{entry.data.summary}</p>
      </a>
    ))}
    {entries.length === 0 && (
      <p style="color:var(--ink-faint);">Nothing published yet — check back soon.</p>
    )}
  </div>
</BaseLayout>

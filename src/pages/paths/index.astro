---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LEARNING_PATHS } from '../../data/paths';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Learning Paths"
  description="Structured cybersecurity curricula — track your course progress, test your understanding with quizzes, and build real-world offensive & defensive skills."
  wide={true}
>
  <div class="paths-header">
    <div class="paths-header-badge">Guided Curriculum</div>
    <h1>Structured Learning Paths</h1>
    <p class="paths-lead">
      Step-by-step roadmaps designed by security practitioners. Track your completion, pass technical quizzes, and move from fundamentals to real-world defense.
    </p>
  </div>

  <div class="paths-grid">
    {LEARNING_PATHS.map((path) => (
      <article
        class="path-card"
        data-path-slug={path.slug}
        data-total-articles={path.articles.length}
        data-articles={JSON.stringify(path.articles.map(a => `${a.col}/${a.slug}`))}
      >
        <div class="card-top">
          <span class="card-icon" aria-hidden="true">{path.icon}</span>
          <span class="level-badge">{path.level}</span>
        </div>

        <h2 class="card-title">{path.title}</h2>
        <p class="card-desc">{path.description}</p>

        <div class="card-meta">
          <span class="meta-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            {path.duration}
          </span>
          <span class="meta-item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 10h16M4 14h10"/></svg>
            {path.articles.length} lessons
          </span>
        </div>

        <!-- Interactive Course Progress Section -->
        <div class="card-progress-box">
          <div class="progress-info-row">
            <span class="progress-status-badge">Not Started</span>
            <span class="progress-metric">0 / {path.articles.length} (0%)</span>
          </div>
          <div class="progress-track" role="progressbar" aria-valuemin={0} aria-valuemax={path.articles.length} aria-valuenow={0}>
            <div class="progress-fill" style="width: 0%"></div>
          </div>
        </div>

        <div class="card-actions">
          <a class="btn-start" href={`${base}paths/${path.slug}/`}>
            <span class="btn-text">Start Path →</span>
          </a>
          <button type="button" class="btn-reset-path" title="Reset path progress" aria-label="Reset progress" hidden style="display: none;">
            ↺
          </button>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>

<script>
  function hydratePathCards() {
    const cards = document.querySelectorAll<HTMLElement>('.path-card');
    if (!cards.length) return;

    let allProgress: Record<string, { completed?: string[] }> = {};
    try {
      const raw = localStorage.getItem('synthreat_path_progress');
      if (raw) allProgress = JSON.parse(raw);
    } catch { /* ignore */ }

    cards.forEach((card) => {
      const slug = card.dataset.pathSlug;
      const rawArticles = card.dataset.articles;
      if (!slug || !rawArticles) return;

      let articleIds: string[] = [];
      try {
        articleIds = JSON.parse(rawArticles);
      } catch { return; }

      const total = articleIds.length;
      const completedList = allProgress[slug]?.completed || [];
      const completedCount = completedList.filter(id => articleIds.includes(id)).length;
      const pct = total > 0 ? Math.round((completedCount / total) * 100) : 0;

      const badge = card.querySelector<HTMLElement>('.progress-status-badge');
      const metric = card.querySelector<HTMLElement>('.progress-metric');
      const fill = card.querySelector<HTMLElement>('.progress-fill');
      const track = card.querySelector<HTMLElement>('.progress-track');
      const btnText = card.querySelector<HTMLElement>('.btn-text');
      const resetBtn = card.querySelector<HTMLButtonElement>('.btn-reset-path');

      if (track) track.setAttribute('aria-valuenow', String(completedCount));
      if (fill) fill.style.width = `${pct}%`;
      if (metric) metric.textContent = `${completedCount} / ${total} (${pct}%)`;

      if (badge && btnText) {
        const isFinished = total > 0 && completedCount >= total;

        if (completedCount === 0) {
          badge.className = 'progress-status-badge is-unstarted';
          badge.textContent = 'Not Started';
          btnText.textContent = 'Start Path →';
          if (resetBtn) {
            resetBtn.hidden = true;
            resetBtn.style.display = 'none';
            resetBtn.classList.remove('is-visible');
          }
        } else if (isFinished) {
          badge.className = 'progress-status-badge is-completed';
          badge.textContent = 'Completed 🏆';
          btnText.textContent = 'Review Path ↺';
          if (resetBtn) {
            resetBtn.hidden = false;
            resetBtn.style.display = 'inline-flex';
            resetBtn.classList.add('is-visible');
          }
        } else {
          badge.className = 'progress-status-badge is-progress';
          badge.textContent = 'In Progress';
          btnText.textContent = 'Resume Path →';
          if (resetBtn) {
            resetBtn.hidden = false;
            resetBtn.style.display = 'inline-flex';
            resetBtn.classList.add('is-visible');
          }
        }
      }

      // Wire reset button
      if (resetBtn && !resetBtn.dataset.wired) {
        resetBtn.dataset.wired = 'true';
        resetBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (confirm(`Reset your progress for this learning path?`)) {
            try {
              const raw = localStorage.getItem('synthreat_path_progress');
              const data = raw ? JSON.parse(raw) : {};
              delete data[slug];
              localStorage.setItem('synthreat_path_progress', JSON.stringify(data));
              window.dispatchEvent(new CustomEvent('synthreat:learning-updated', { detail: { slug, reset: true } }));
              hydratePathCards();
            } catch { /* ignore */ }
          }
        });
      }
    });
  }

  hydratePathCards();
  window.addEventListener('storage', hydratePathCards);
  window.addEventListener('synthreat:learning-updated', hydratePathCards);
</script>

<style>
  .paths-header {
    margin-bottom: 2.5rem;
  }

  .paths-header-badge {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .paths-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 0.6rem;
  }

  .paths-lead {
    font-size: 1.05rem;
    color: var(--ink-soft);
    max-width: 65ch;
    margin: 0;
    line-height: 1.6;
  }

  .paths-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 720px) {
    .paths-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Card ── */
  .path-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.75rem;
    transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
    position: relative;
    box-shadow: var(--shadow);
  }

  .path-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .card-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .level-badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    padding: 0.25em 0.75em;
    border-radius: 999px;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .meta-item svg {
    opacity: 0.7;
    flex-shrink: 0;
  }

  /* ── Course Progress Widget ── */
  .card-progress-box {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .progress-info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
  }

  .progress-status-badge {
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .progress-status-badge.is-unstarted {
    background: var(--surface);
    color: var(--ink-faint);
    border: 1px solid var(--line);
  }

  .progress-status-badge.is-progress {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .progress-status-badge.is-completed {
    background: color-mix(in srgb, #22c55e 14%, transparent);
    color: #16a34a;
    border: 1px solid color-mix(in srgb, #22c55e 35%, transparent);
  }

  .progress-metric {
    font-weight: 600;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .progress-track {
    height: 6px;
    background: var(--surface);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 0.35s ease;
  }

  /* ── Actions ── */
  .card-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
  }

  .btn-start {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.65rem 1.1rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.15s, transform 0.12s;
  }

  .btn-start:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-reset-path {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-faint);
    font-size: 16px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-reset-path.is-visible {
    display: inline-flex;
  }

  .btn-reset-path:hover {
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.4);
  }
</style>

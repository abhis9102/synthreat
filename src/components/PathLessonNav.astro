---
// PathLessonNav.astro — Interactive course step tracker embedded in articles
import { getPathsForArticle } from '../data/paths';

interface Props {
  col: string;
  slug: string;
}

const { col, slug } = Astro.props;
const pathContexts = getPathsForArticle(col, slug);
const base = import.meta.env.BASE_URL;
const articleId = `${col}/${slug}`;
---

{pathContexts.length > 0 && (
  <aside class="path-lesson-nav" aria-label="Learning Path Navigation">
    {pathContexts.map((ctx) => (
      <div class="path-nav-card" data-path-slug={ctx.path.slug} data-article-id={articleId}>
        <div class="path-nav-header">
          <div class="path-nav-title-group">
            <span class="path-nav-icon">{ctx.path.icon}</span>
            <div>
              <span class="path-nav-eyebrow">Learning Path</span>
              <a href={`${base}paths/${ctx.path.slug}/`} class="path-nav-name">{ctx.path.title}</a>
            </div>
          </div>
          <div class="path-nav-step">
            <span class="step-counter">Lesson {ctx.stepIndex} of {ctx.totalSteps}</span>
            <button
              type="button"
              class="path-toggle-btn"
              data-path-slug={ctx.path.slug}
              data-article-id={articleId}
              aria-label="Toggle completed state for this lesson"
            >
              <span class="toggle-icon">○</span>
              <span class="toggle-text">Mark Completed</span>
            </button>
          </div>
        </div>

        <div class="path-nav-links">
          {ctx.prevArticle ? (
            <a href={`${base}${ctx.prevArticle.col}/${ctx.prevArticle.slug}/`} class="path-nav-prev" title={ctx.prevArticle.title}>
              ← {ctx.prevArticle.title}
            </a>
          ) : (
            <span class="path-nav-empty">First lesson</span>
          )}

          <a href={`${base}paths/${ctx.path.slug}/`} class="path-nav-syllabus">
            View Syllabus
          </a>

          {ctx.nextArticle ? (
            <a href={`${base}${ctx.nextArticle.col}/${ctx.nextArticle.slug}/`} class="path-nav-next" title={ctx.nextArticle.title}>
              {ctx.nextArticle.title} →
            </a>
          ) : (
            <a href={`${base}paths/${ctx.path.slug}/`} class="path-nav-complete-badge">
              🎉 Path Complete →
            </a>
          )}
        </div>
      </div>
    ))}
  </aside>
)}

<script>
  function hydrateLessonNav() {
    const cards = document.querySelectorAll<HTMLElement>('.path-nav-card');
    if (!cards.length) return;

    let allProgress: Record<string, { completed?: string[] }> = {};
    try {
      const raw = localStorage.getItem('synthreat_path_progress');
      if (raw) allProgress = JSON.parse(raw);
    } catch { /* ignore */ }

    cards.forEach((card) => {
      const pathSlug = card.dataset.pathSlug;
      const articleId = card.dataset.articleId;
      if (!pathSlug || !articleId) return;

      const completed = allProgress[pathSlug]?.completed || [];
      const isDone = completed.includes(articleId);

      const btn = card.querySelector<HTMLButtonElement>('.path-toggle-btn');
      if (btn) {
        if (isDone) {
          btn.classList.add('is-completed');
          btn.querySelector('.toggle-icon')!.textContent = '✓';
          btn.querySelector('.toggle-text')!.textContent = 'Completed';
        } else {
          btn.classList.remove('is-completed');
          btn.querySelector('.toggle-icon')!.textContent = '○';
          btn.querySelector('.toggle-text')!.textContent = 'Mark Completed';
        }

        // Attach click listener once
        if (!btn.dataset.wired) {
          btn.dataset.wired = 'true';
          btn.addEventListener('click', () => {
            toggleLesson(pathSlug, articleId);
          });
        }
      }
    });
  }

  function toggleLesson(pathSlug: string, articleId: string) {
    try {
      const raw = localStorage.getItem('synthreat_path_progress');
      const all = raw ? JSON.parse(raw) : {};
      const current = all[pathSlug]?.completed || [];

      let updated: string[];
      const isCompleted = !current.includes(articleId);

      if (isCompleted) {
        updated = [...current, articleId];
      } else {
        updated = current.filter((id: string) => id !== articleId);
      }

      all[pathSlug] = {
        completed: updated,
        lastUpdated: new Date().toISOString(),
      };

      localStorage.setItem('synthreat_path_progress', JSON.stringify(all));

      // Broadcast update
      window.dispatchEvent(new CustomEvent('synthreat:learning-updated', {
        detail: { pathSlug, articleId, isCompleted }
      }));

      hydrateLessonNav();
    } catch (e) {
      console.warn('Could not update path progress', e);
    }
  }

  // Auto-mark when quiz is passed!
  window.addEventListener('synthreat:learning-updated', (e: any) => {
    if (e.detail?.passed) {
      // If a quiz on this article was passed, ensure it is marked completed
      const cards = document.querySelectorAll<HTMLElement>('.path-nav-card');
      cards.forEach((card) => {
        const pathSlug = card.dataset.pathSlug;
        const articleId = card.dataset.articleId;
        if (pathSlug && articleId) {
          const raw = localStorage.getItem('synthreat_path_progress');
          const all = raw ? JSON.parse(raw) : {};
          const current = all[pathSlug]?.completed || [];
          if (!current.includes(articleId)) {
            all[pathSlug] = {
              completed: [...current, articleId],
              lastUpdated: new Date().toISOString(),
            };
            localStorage.setItem('synthreat_path_progress', JSON.stringify(all));
          }
        }
      });
    }
    hydrateLessonNav();
  });

  hydrateLessonNav();
  window.addEventListener('storage', hydrateLessonNav);
</script>

<style>
  .path-lesson-nav {
    margin: 40px 0 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .path-nav-card {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: var(--shadow);
  }

  .path-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .path-nav-title-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .path-nav-icon {
    font-size: 24px;
    flex-shrink: 0;
  }

  .path-nav-eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    margin-bottom: 2px;
  }

  .path-nav-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s;
  }
  .path-nav-name:hover {
    color: var(--accent);
  }

  .path-nav-step {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .step-counter {
    font-size: 12.5px;
    color: var(--ink-soft);
    font-weight: 600;
  }

  .path-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink-soft);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .path-toggle-btn:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  .path-toggle-btn.is-completed {
    background: color-mix(in srgb, #22c55e 14%, transparent);
    border-color: color-mix(in srgb, #22c55e 40%, transparent);
    color: #16a34a;
  }

  .toggle-icon {
    font-weight: 800;
  }

  .path-nav-links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 13px;
  }

  .path-nav-prev,
  .path-nav-next {
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    max-width: 240px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 0.15s;
  }

  .path-nav-prev:hover,
  .path-nav-next:hover {
    opacity: 0.8;
  }

  .path-nav-empty {
    font-size: 12px;
    color: var(--ink-faint);
  }

  .path-nav-syllabus {
    color: var(--ink-faint);
    text-decoration: none;
    font-size: 12px;
  }
  .path-nav-syllabus:hover {
    color: var(--ink);
  }

  .path-nav-complete-badge {
    font-weight: 700;
    color: #16a34a;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .path-nav-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .path-nav-step {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

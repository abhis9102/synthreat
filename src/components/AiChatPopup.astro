        copyBiz.classList.add('success');
        copyBiz.textContent = 'Copied!';
        setTimeout(() => { copyBiz.classList.remove('success'); copyBiz.textContent = 'Copy Talk Track'; }, 2000);
      });
      toolbar.appendChild(copyBiz);
    }

    if (techMatch) {
      hasSpecial = true;
      const copyTech = document.createElement('button');
      copyTech.className = 'ai-popup-tool-btn';
      copyTech.innerHTML = `<span>Copy Tech Fix</span>`;
      copyTech.addEventListener('click', () => {
        navigator.clipboard.writeText(techMatch[1].trim());
        copyTech.classList.add('success');
        copyTech.textContent = 'Copied!';
        setTimeout(() => { copyTech.classList.remove('success'); copyTech.textContent = 'Copy Tech Fix'; }, 2000);
      });
      toolbar.appendChild(copyTech);
    }

    if (!hasSpecial) {
      const copyAll = document.createElement('button');
      copyAll.className = 'ai-popup-tool-btn';
      copyAll.innerHTML = `<span>Copy Response</span>`;
      copyAll.addEventListener('click', () => {
        navigator.clipboard.writeText(turn.assistantText);
        copyAll.classList.add('success');
        copyAll.textContent = 'Copied!';
        setTimeout(() => { copyAll.classList.remove('success'); copyAll.textContent = 'Copy Response'; }, 2000);
      });
      toolbar.appendChild(copyAll);
    }

    const deleteBtn = document.createElement('button');
    deleteBtn.className = 'ai-popup-tool-btn danger';
    deleteBtn.innerHTML = `
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      <span>Delete</span>
    `;
    deleteBtn.addEventListener('click', () => deletePopupTurn(turn.id));
    toolbar.appendChild(deleteBtn);

    card.appendChild(toolbar);
    thread.appendChild(card);
  }

  function restorePopupState() {
    try {
      const pageKey = `synthreat_popup_turns_${encodeURIComponent(window.location.pathname)}`;
      const raw = localStorage.getItem(pageKey);
      if (!raw) return;
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed) || parsed.length === 0) return;
      popupTurns = parsed;
      popupHistory = popupTurns.flatMap(t => [
        { role: 'user', parts: [{ text: t.userQuery }] },
        { role: 'model', parts: [{ text: t.assistantText }] }
      ]);
      for (const t of popupTurns) {
        renderCompletedPopupTurn(t);
      }
      updatePopupClearVisibility(true);
      requestAnimationFrame(() => {
        thread.scrollTop = thread.scrollHeight;
        updateJumpButtonVisibility();
      });
    } catch {}
  }

  loadKnowledgeIndex();
  restorePopupState();
</script>

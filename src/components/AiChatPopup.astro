</style>

<script>
  import { marked } from 'marked';

  let knowledgeIndex: any[] = [];
  let isGenerating = false;
  let popupHistory: Array<{ role: string; parts: Array<{ text: string }> }> = [];

  interface AttachedFile {
    name: string;
    size: string;
    type: 'image' | 'pdf' | 'text';
    mimeType?: string;
    data?: string;
    dataUrl?: string;
    textContent?: string;
  }

  interface PopupTurn {
    id: string;
    userQuery: string;
    assistantText: string;
    matched?: any[];
    attachment?: {
      name: string;
      size: string;
      type: 'image' | 'pdf' | 'text';
      dataUrl?: string;
    };
  }
  let popupTurns: PopupTurn[] = [];

  const drawer = document.getElementById('aiPopupDrawer') as HTMLElement;
  const scrim = document.getElementById('aiPopupScrim') as HTMLElement;
  const closeBtn = document.getElementById('aiPopupCloseBtn');
  const fab = document.getElementById('aiPopupFab');
  const thread = document.getElementById('aiPopupThread') as HTMLElement;
  const welcome = document.getElementById('aiPopupWelcome') as HTMLElement;
  const input = document.getElementById('aiPopupInput') as HTMLTextAreaElement;
  const form = document.getElementById('aiPopupForm');
  const sendBtn = document.getElementById('aiPopupSendBtn') as HTMLButtonElement;
  const clearBtn = document.getElementById('aiPopupClearBtn');
  const clearHeaderBtn = document.getElementById('aiPopupClearHeaderBtn');
  const topicBadge = document.getElementById('aiPopupTopicBadge');
  const expandBtn = document.getElementById('aiPopupExpandBtn') as HTMLAnchorElement;

  const attachBtn = document.getElementById('aiPopupAttachBtn');
  const fileInput = document.getElementById('aiPopupFileInput') as HTMLInputElement;
  const filePreview = document.getElementById('aiPopupFilePreview');
  let currentAttachment: AttachedFile | null = null;

  const keyToggleBtn = document.getElementById('aiPopupKeyToggleBtn');
  const keyPanel = document.getElementById('aiPopupKeyPanel');
  const keyInput = document.getElementById('aiPopupKeyInput') as HTMLInputElement;
  const saveKeyBtn = document.getElementById('aiPopupSaveKeyBtn');
  const keyStatus = document.getElementById('aiPopupKeyStatus');

  const base = drawer?.dataset.base || '/synthreat/';
  const defaultKey = drawer?.dataset.defaultKey || '';
  let pendingQuery = '';

  function getActiveApiKey(): string {
    const stored = localStorage.getItem('synthreat_gemini_key');
    if (stored && stored.trim()) return stored.trim();
    return defaultKey;
  }

  function toggleKeyPanel(forceOpen?: boolean) {
    if (!keyPanel) return;
    const shouldOpen = forceOpen !== undefined ? forceOpen : keyPanel.style.display === 'none';
    keyPanel.style.display = shouldOpen ? 'flex' : 'none';
    if (shouldOpen) {
      const active = getActiveApiKey();
      if (active && keyInput) keyInput.value = active;
      setTimeout(() => keyInput?.focus(), 60);
    }
  }

  keyToggleBtn?.addEventListener('click', () => toggleKeyPanel());

  saveKeyBtn?.addEventListener('click', () => {
    const k = keyInput?.value.trim() || '';
    if (k) {
      localStorage.setItem('synthreat_gemini_key', k);
      if (keyStatus) {
        keyStatus.textContent = 'Key saved! Running your question...';
        keyStatus.style.color = 'var(--accent-ink)';
      }
      setTimeout(() => {
        if (keyPanel) keyPanel.style.display = 'none';
        if (pendingQuery) {
          const q = pendingQuery;
          pendingQuery = '';
          submitPopupPrompt(q);
        }
      }, 500);
    } else {
      localStorage.removeItem('synthreat_gemini_key');
      if (keyStatus) {
        keyStatus.textContent = 'Custom key cleared.';
        keyStatus.style.color = 'var(--ink-faint)';
      }
    }
  });

  // Load index
  async function loadKnowledgeIndex() {
    try {
      const res = await fetch(`${base}synthreat-ai-index.json`);
      if (res.ok) knowledgeIndex = await res.json();
    } catch {}
  }

  function isConversational(query: string): boolean {
    const q = query.toLowerCase().trim().replace(/[^a-z0-9\s]/g, '');
    if (!q) return true;
    const conversationalTokens = new Set([
      'hi', 'hello', 'hey', 'greetings', 'howdy', 'hlow', 'hola',
      'test', 'testing', 'ping',
      'yes', 'no', 'es', 'ok', 'okay', 'sure', 'yep', 'yeah', 'cool',
      'thanks', 'thank', 'you', 'got', 'it', 'thx',
      'who', 'are', 'you', 'what', 'can', 'do', 'help'
    ]);
    const words = q.split(/\s+/);
    return words.length <= 3 && words.every(w => conversationalTokens.has(w));
  }

  const GROUNDING_STOPWORDS = new Set([
    'explain', 'what', 'how', 'why', 'can', 'does', 'with', 'for', 'from', 'about',
    'into', 'that', 'this', 'business', 'impact', 'mechanics', 'technical', 'non',
    'stakeholders', 'executive', 'translate', 'guidance', 'perspective', 'analysis',
    'overview', 'summary', 'difference', 'diff', 'versus', 'vs', 'vulnerability',
    'vulnerabilities', 'attack', 'attacks', 'security', 'issue', 'issues', 'risk',
    'risks', 'report', 'check', 'test', 'help', 'and', 'the', 'its', 'are', 'you',
    'who', 'which', 'where', 'when', 'will', 'should', 'would', 'could', 'want',
    'please', 'tell', 'show', 'give', 'detail', 'details'
  ]);

  function findRelevantArticles(query: string, topN = 3) {
    if (isConversational(query)) return [];
    if (!knowledgeIndex || !knowledgeIndex.length) return [];

    const queryClean = query.toLowerCase().replace(/[^a-z0-9\s]/g, ' ');
    const tokens = queryClean.split(/\s+/).filter(t => t.length > 2 && !GROUNDING_STOPWORDS.has(t));
    if (!tokens.length) return [];

    const scored = knowledgeIndex.map(entry => {
      let score = 0;
      const titleL = (entry.title || '').toLowerCase();
      const slugL = (entry.slug || '').toLowerCase();
      const techL = (entry.tech || '').toLowerCase();
      const bizL = (entry.biz || '').toLowerCase();
      const summaryL = (entry.summary || '').toLowerCase();

      for (const token of tokens) {
        if (titleL.includes(token)) score += 15;
        if (slugL.includes(token)) score += 12;
        if (summaryL.includes(token)) score += 5;
        if (techL.includes(token)) score += 3;
        if (bizL.includes(token)) score += 3;
      }

      // Title phrase match bonus
      if (queryClean.includes(titleL) || (titleL.length > 6 && queryClean.includes(titleL.slice(0, 15)))) {
        score += 35;
      }
      return { entry, score };
    });

    const candidates = scored.filter(item => item.score >= 15).sort((a, b) => b.score - a.score);
    if (!candidates.length) return [];

    const topScore = candidates[0].score;
    return candidates
      .filter(item => item.score >= Math.max(15, topScore * 0.4))
      .slice(0, topN)
      .map(item => item.entry);
  }

  function buildPopupPrompt(matched: any[]) {
    const grounded = matched.map(m => `
--- Article: ${m.title} (${m.col}/${m.slug}) ---
Surface: ${m.surface}
CWE: ${m.cwe?.join(', ') || 'N/A'}
Summary: ${m.summary}
Technical: ${m.tech}
Business: ${m.biz}
Fix: ${m.fix}
`).join('\n');

    return `
You are Synthreat AI, an expert cybersecurity copilot and consultant.

CORE MANDATE (CRITICAL):
- STRICT BREVITY: Total response MUST be under 160 words. No filler, no conversational preambles.
- ZERO JARGON: Plain language mechanics over acronym stacking.
- HIGH ACCURACY: Grounded in verified standards (OWASP, CWE, CVSS, NIST).

DYNAMIC CONTEXT & INTENT:
1. GREETINGS, CASUAL & TEST MESSAGES (e.g. "hi", "hello", "hlow", "test", "thanks", "ok", "yes", "es"):
   - Reply naturally, politely, and concisely in 1-2 sentences.
   - For tests: confirm system operational readiness immediately.
   - NEVER output structural headings or exploit templates for greetings or tests.

2. SPECIFIC QUESTIONS (e.g. "Can automated scanners detect IDOR?", "Difference between X and Y", "Show code fix"):
   - Answer directly and concisely in 2-4 punchy sentences or clear bullets.
   - Do not force rigid perspective headings unless full vulnerability analysis is requested.

3. FULL VULNERABILITY / ATTACK TOPIC INQUIRIES (e.g. "Explain CSRF", deep-link button prompts, or topic overviews):
   Deliver Synthreat's dual perspective strictly adhering to this concise format:

## 🛠 Technical Perspective
- **Broken Trust Boundary:** [1 concise sentence: what assumption failed]
- **Exploit Flow:**
  1. [Entry: trigger or unvalidated input - max 12 words]
  2. [Bypass: boundary pivot or privilege escalation - max 12 words]
  3. [Impact: data exfiltration or system control - max 12 words]
- **The Real Fix:** [1 actionable sentence: verified defense, not just a band-aid]

## 💼 Business & Executive Translation
- **Real Cost Exposure:** [2-3 short bullet items: regulatory fines, downtime hours, breach response]
- **Executive Talk Track:** "[Strictly 2 direct sentences for CEO/CFO without alarmism or tech buzzwords]"

Grounded Synthreat Knowledge:
${grounded || 'General cybersecurity principles apply.'}
`;
  }

  // Open & Close
  function openPopup(initialQuery?: string, topicName?: string) {
    drawer?.classList.add('open');
    fab?.classList.add('chat-open');
    scrim?.classList.add('open');
    document.body.style.overflow = 'hidden';

    if (topicName && topicBadge) {
      topicBadge.textContent = topicName;
      topicBadge.style.display = 'inline-block';
    }

    if (initialQuery) {
      if (expandBtn) expandBtn.href = `${base}assistant/?q=${encodeURIComponent(initialQuery)}`;
      if (thread.children.length <= 1) {
        submitPopupPrompt(initialQuery);
      }
    }

    setTimeout(() => {
      input?.focus();
      if (thread) {
        thread.scrollTop = thread.scrollHeight;
        updateJumpButtonVisibility();
      }
    }, 150);
  }

  function closePopup() {
    drawer?.classList.remove('open');
    scrim?.classList.remove('open');
    fab?.classList.remove('chat-open');
    document.body.style.overflow = '';
  }

  scrim?.addEventListener('click', closePopup);
  closeBtn?.addEventListener('click', closePopup);
  fab?.addEventListener('click', () => {
    if (drawer?.classList.contains('open')) {
      closePopup();
    } else {
      const pageH1 = document.querySelector('h1')?.textContent?.trim() || '';
      openPopup(pageH1 ? `Explain ${pageH1} mechanics and executive risk framing` : '', pageH1);
    }
  });

  // Messenger-style scroll tracking & delegation
  let userInterruptedScroll = false;
  const jumpBtn = document.getElementById('aiPopupJumpBtn');

  function isScrolledNearBottom(threshold = 80): boolean {
    if (!thread) return true;
    return thread.scrollHeight - thread.scrollTop - thread.clientHeight <= threshold;
  }

  function updateJumpButtonVisibility() {
    if (!thread || !jumpBtn) return;
    const isNear = isScrolledNearBottom(80);
    const canScroll = thread.scrollHeight > thread.clientHeight + 30;
    if (canScroll && !isNear) {
      jumpBtn.style.display = 'flex';
    } else {
      jumpBtn.style.display = 'none';
    }
  }

  thread?.addEventListener('scroll', () => {
    if (isScrolledNearBottom(40)) {
      userInterruptedScroll = false;
    }
    updateJumpButtonVisibility();
  }, { passive: true });

  jumpBtn?.addEventListener('click', () => {
    userInterruptedScroll = false;
    if (thread) {
      thread.scrollTo({ top: thread.scrollHeight, behavior: 'smooth' });
    }
  });

  // Direct, smooth wheel delegation: scrolling anywhere over the chat popup scrolls the thread and NEVER the background page
  drawer?.addEventListener('wheel', (e) => {
    // If horizontal trackpad scroll over code block or preview chips, allow native horizontal scroll
    if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
      const target = e.target as HTMLElement;
      if (target.closest('pre, code, .ai-file-preview-bar')) {
        return;
      }
    }
    e.preventDefault();
    e.stopPropagation();
    if (thread) {
      if (e.deltaY < 0) {
        userInterruptedScroll = true;
      } else if (thread.scrollHeight - thread.scrollTop - thread.clientHeight <= 40) {
        userInterruptedScroll = false;
      }
      thread.scrollTop += e.deltaY;
      updateJumpButtonVisibility();
    }
  }, { passive: false });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('open')) {
      closePopup();
    }
  });

  // Intercept all "Ask Synthreat AI about..." buttons across any page!
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('.ai-ask-btn') as HTMLElement | null;
    if (!btn) return;
    // Allow Cmd+click or Ctrl+click to open in new tab
    if (e.metaKey || e.ctrlKey) return;
    e.preventDefault();
    const prompt = btn.dataset.aiPrompt || btn.textContent?.trim() || '';
    const topic = btn.dataset.topic || document.querySelector('h1')?.textContent?.trim() || '';
    openPopup(prompt, topic);
  });

  // Auto-resize textarea
  input?.addEventListener('input', () => {
    input.style.height = 'auto';
    input.style.height = `${Math.min(input.scrollHeight, 120)}px`;
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form?.dispatchEvent(new Event('submit'));
    }
  });

  // --- File Upload & Attachment Processing ---
  attachBtn?.addEventListener('click', () => {
    fileInput?.click();
  });

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    await processSelectedFile(file);
    fileInput.value = '';
  });

  // Paste image from clipboard directly into textarea
  input?.addEventListener('paste', async (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    for (const item of items) {
      if (item.type.startsWith('image/')) {
        const file = item.getAsFile();
        if (file) {
          e.preventDefault();
          await processSelectedFile(file);
          break;
        }
      }
    }
  });

  // Drag & drop files onto the chat drawer
  drawer?.addEventListener('dragover', (e) => {
    e.preventDefault();
  });
  drawer?.addEventListener('drop', async (e) => {
    e.preventDefault();
    const file = e.dataTransfer?.files?.[0];
    if (file) {
      await processSelectedFile(file);
    }
  });

  function formatFileSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function readFileAsDataURL(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result as string);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  function readFileAsText(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result as string);
      reader.onerror = reject;
      reader.readAsText(file);
    });
  }

  // Lightweight standard-compliant .docx text extractor using DecompressionStream
  async function extractDocxText(arrayBuffer: ArrayBuffer): Promise<string> {
    const bytes = new Uint8Array(arrayBuffer);
    const view = new DataView(arrayBuffer);
    let offset = 0;
    while (offset < bytes.length - 30) {
      if (view.getUint32(offset, true) !== 0x04034b50) {
        offset++;
        continue;
      }
      const compression = view.getUint16(offset + 8, true);
      const compressedSize = view.getUint32(offset + 18, true);
      const fileNameLen = view.getUint16(offset + 26, true);
      const extraLen = view.getUint16(offset + 28, true);
      const fileNameBytes = bytes.subarray(offset + 30, offset + 30 + fileNameLen);
      const fileName = new TextDecoder().decode(fileNameBytes);
      const dataStart = offset + 30 + fileNameLen + extraLen;
      const dataEnd = dataStart + compressedSize;

      if (fileName === 'word/document.xml') {
        const compData = bytes.subarray(dataStart, dataEnd);
        let xml = '';
        if (compression === 8 && typeof DecompressionStream !== 'undefined') {
          const stream = new Response(compData).body?.pipeThrough(new DecompressionStream('deflate-raw'));
          if (stream) xml = await new Response(stream).text();
        } else {
          xml = new TextDecoder().decode(compData);
        }
        return xml.replace(/<w:p[^>]*>/g, '\n').replace(/<[^>]+>/g, '').replace(/\n{3,}/g, '\n\n').trim();
      }
      offset = dataStart + compressedSize;
    }
    return '';
  }

  async function processSelectedFile(file: File) {
    if (file.size > 10 * 1024 * 1024) {
      alert('File exceeds 10MB limit. Please choose a smaller file.');
      return;
    }

    const name = file.name;
    const size = formatFileSize(file.size);
    const ext = name.split('.').pop()?.toLowerCase() || '';

    // 1. Image (JPEG, PNG, WebP)
    if (file.type.startsWith('image/') || ['jpg', 'jpeg', 'png', 'webp'].includes(ext)) {
      const dataUrl = await readFileAsDataURL(file);
      const base64 = dataUrl.split(',')[1] || '';
      const mimeType = file.type || (ext === 'png' ? 'image/png' : 'image/jpeg');
      currentAttachment = { name, size, type: 'image', mimeType, data: base64, dataUrl };
    }
    // 2. PDF Document
    else if (file.type === 'application/pdf' || ext === 'pdf') {
      const dataUrl = await readFileAsDataURL(file);
      const base64 = dataUrl.split(',')[1] || '';
      currentAttachment = { name, size, type: 'pdf', mimeType: 'application/pdf', data: base64 };
    }
    // 3. Word Document (.docx)
    else if (ext === 'docx') {
      try {
        const ab = await file.arrayBuffer();
        const extracted = await extractDocxText(ab);
        currentAttachment = { name, size, type: 'text', textContent: extracted || '[Empty Word document]' };
      } catch (err) {
        const text = await readFileAsText(file);
        currentAttachment = { name, size, type: 'text', textContent: text };
      }
    }
    // 4. Text / Code / CSV / Markdown
    else {
      const text = await readFileAsText(file);
      currentAttachment = { name, size, type: 'text', textContent: text };
    }

    renderFilePreview();
  }

  function renderFilePreview() {
    if (!filePreview) return;
    if (!currentAttachment) {
      filePreview.style.display = 'none';
      filePreview.innerHTML = '';
      return;
    }
    filePreview.style.display = 'flex';
    filePreview.innerHTML = `
      <div class="ai-file-chip">
        ${currentAttachment.type === 'image' && currentAttachment.dataUrl
          ? `<img src="${currentAttachment.dataUrl}" class="ai-file-thumb" alt="Preview" />`
          : `<span class="ai-file-icon">${currentAttachment.type === 'pdf' ? '📄' : '📝'}</span>`
        }
        <div class="ai-file-info">
          <span class="ai-file-name" title="${escapeHtml(currentAttachment.name)}">${escapeHtml(currentAttachment.name)}</span>
          <span class="ai-file-size">${currentAttachment.size}</span>
        </div>
        <button type="button" class="ai-file-remove-btn" title="Remove file" aria-label="Remove attached file">✕</button>
      </div>
    `;
    filePreview.querySelector('.ai-file-remove-btn')?.addEventListener('click', () => {
      currentAttachment = null;
      renderFilePreview();
    });
  }

  function renderAttachmentBadge(att?: { name: string; size: string; type: 'image' | 'pdf' | 'text'; dataUrl?: string }): string {
    if (!att) return '';
    if (att.type === 'image' && att.dataUrl) {
      return `
        <div class="ai-bubble-attachment">
          <img src="${att.dataUrl}" alt="${escapeHtml(att.name)}" />
          <div class="ai-bubble-attachment-name">🖼️ ${escapeHtml(att.name)} <span style="font-weight:400; font-size:11px; color:var(--ink-faint);">(${att.size})</span></div>
        </div>
      `;
    }
    const icon = att.type === 'pdf' ? '📄' : '📝';
    return `
      <div class="ai-bubble-attachment">
        <div class="ai-bubble-attachment-name">${icon} ${escapeHtml(att.name)} <span style="font-weight:400; font-size:11px; color:var(--ink-faint);">(${att.size})</span></div>
      </div>
    `;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = input?.value.trim();
    if ((!val && !currentAttachment) || isGenerating) return;
    const toSend = val || (currentAttachment ? `Analyze this attached ${currentAttachment.name}:` : '');
    input.value = '';
    input.style.height = 'auto';
    submitPopupPrompt(toSend);
  });

  function updatePopupClearVisibility(hasMessages: boolean) {
    if (clearBtn) clearBtn.style.display = hasMessages ? 'inline-flex' : 'none';
    if (clearHeaderBtn) clearHeaderBtn.style.display = hasMessages ? 'inline-flex' : 'none';
  }

  function savePopupState() {
    try {
      const pageKey = `synthreat_popup_turns_${encodeURIComponent(window.location.pathname)}`;
      // Strip dataUrl (base64 image data) before saving — prevents quota errors
      // Metadata (name, size, type) is kept so the badge still renders
      const slim = popupTurns.map(t => ({
        ...t,
        attachment: t.attachment ? { name: t.attachment.name, size: t.attachment.size, type: t.attachment.type } : undefined
      }));
      localStorage.setItem(pageKey, JSON.stringify(slim));
    } catch (e: any) {
      if (e?.name === 'QuotaExceededError') {
        // If storage full, keep only last 10 turns
        try {
          const pageKey = `synthreat_popup_turns_${encodeURIComponent(window.location.pathname)}`;
          const slim = popupTurns.slice(-10).map(t => ({
            ...t,
            attachment: t.attachment ? { name: t.attachment.name, size: t.attachment.size, type: t.attachment.type } : undefined
          }));
          localStorage.setItem(pageKey, JSON.stringify(slim));
        } catch {}
      }
    }
  }

  function clearPopupChat() {
    thread.innerHTML = '';
    popupTurns = [];
    popupHistory = [];
    try {
      const pageKey = `synthreat_popup_turns_${encodeURIComponent(window.location.pathname)}`;
      localStorage.removeItem(pageKey);
    } catch {}
    updatePopupClearVisibility(false);
    if (welcome) thread.appendChild(welcome);
  }

  clearBtn?.addEventListener('click', clearPopupChat);
  clearHeaderBtn?.addEventListener('click', clearPopupChat);

  function deletePopupTurn(turnId: string) {
    const turnIndex = popupTurns.findIndex(t => t.id === turnId);
    if (turnIndex !== -1) {
      popupTurns.splice(turnIndex, 1);
      popupHistory = popupTurns.flatMap(t => [
        { role: 'user', parts: [{ text: t.userQuery }] },
        { role: 'model', parts: [{ text: t.assistantText }] }
      ]);
      savePopupState();
    }

    document.querySelectorAll(`#aiPopupThread [data-turn-id="${turnId}"]`).forEach(el => el.remove());

    if (popupTurns.length === 0) {
      if (welcome) thread.appendChild(welcome);
      updatePopupClearVisibility(false);
    } else {
      updatePopupClearVisibility(true);
    }
  }

  function editAndResubmitPopupTurn(turnId: string, newQuery: string) {
    if (isGenerating) return;
    const turnIndex = popupTurns.findIndex(t => t.id === turnId);
    if (turnIndex === -1) {
      submitPopupPrompt(newQuery);
      return;
    }

    const turnsToRemove = popupTurns.slice(turnIndex);
    popupTurns = popupTurns.slice(0, turnIndex);
    popupHistory = popupTurns.flatMap(t => [
      { role: 'user', parts: [{ text: t.userQuery }] },
      { role: 'model', parts: [{ text: t.assistantText }] }
    ]);
    savePopupState();

    for (const t of turnsToRemove) {
      document.querySelectorAll(`#aiPopupThread [data-turn-id="${t.id}"]`).forEach(el => el.remove());
    }

    submitPopupPrompt(newQuery);
  }

  function attachPopupUserTurnHandlers(userGroup: HTMLElement, turnId: string) {
    const bubbleBox = userGroup.querySelector('.ai-popup-user-bubble-box') as HTMLElement;
    const editBox = userGroup.querySelector('.ai-popup-user-edit-box') as HTMLElement;
    const editBtn = userGroup.querySelector('.edit-btn') as HTMLElement;
    const deleteBtn = userGroup.querySelector('.delete-btn') as HTMLElement;
    const textarea = userGroup.querySelector('.ai-popup-edit-textarea') as HTMLTextAreaElement;
    const cancelBtn = userGroup.querySelector('.ai-popup-edit-cancel') as HTMLElement;
    const saveBtn = userGroup.querySelector('.ai-popup-edit-save') as HTMLElement;

    editBtn?.addEventListener('click', () => {
      if (isGenerating) return;
      if (bubbleBox && editBox && textarea) {
        bubbleBox.style.display = 'none';
        editBox.style.display = 'flex';
        textarea.value = userGroup.querySelector('.ai-popup-user-bubble')?.textContent || '';
        textarea.style.height = 'auto';
        textarea.style.height = `${Math.min(textarea.scrollHeight, 140)}px`;
        textarea.focus();
      }
    });

    function closeEdit() {
      if (bubbleBox && editBox) {
        editBox.style.display = 'none';
        bubbleBox.style.display = 'flex';
      }
    }

    cancelBtn?.addEventListener('click', closeEdit);

    function saveAndResubmit() {
      const val = textarea?.value.trim();
      if (!val) return;
      closeEdit();
      editAndResubmitPopupTurn(turnId, val);
    }

    saveBtn?.addEventListener('click', saveAndResubmit);

    textarea?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        saveAndResubmit();
      } else if (e.key === 'Escape') {
        closeEdit();
      }
    });

    textarea?.addEventListener('input', () => {
      textarea.style.height = 'auto';
      textarea.style.height = `${Math.min(textarea.scrollHeight, 140)}px`;
    });

    deleteBtn?.addEventListener('click', () => {
      deletePopupTurn(turnId);
    });
  }

  async function submitPopupPrompt(userQuery: string) {
    const apiKey = getActiveApiKey();
    if (!apiKey) {
      pendingQuery = userQuery;
      toggleKeyPanel(true);
      if (keyStatus) {
        keyStatus.textContent = 'Enter your Gemini API key to ask questions directly on this page:';
        keyStatus.style.color = 'var(--accent)';
      }
      return;
    }

    const attached = currentAttachment;
    currentAttachment = null;
    renderFilePreview();

    if (welcome && welcome.parentElement) welcome.remove();
    updatePopupClearVisibility(true);

    const turnId = 'pturn_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7);

    // 1. User Message Group
    const userGroup = document.createElement('div');
    userGroup.className = 'ai-popup-user-group';
    userGroup.dataset.turnId = turnId;
    userGroup.innerHTML = `
      <div class="ai-popup-user-bubble-box">
        <div class="ai-popup-user-bubble">
          ${renderAttachmentBadge(attached ? { name: attached.name, size: attached.size, type: attached.type, dataUrl: attached.dataUrl } : undefined)}
          <div>${escapeHtml(userQuery)}</div>
        </div>
        <div class="ai-popup-msg-actions">
          <button type="button" class="ai-popup-msg-btn edit-btn" title="Edit message" aria-label="Edit message">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            <span>Edit</span>
          </button>
          <button type="button" class="ai-popup-msg-btn delete-btn" title="Delete turn" aria-label="Delete turn">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            <span>Delete</span>
          </button>
        </div>
      </div>
      <div class="ai-popup-user-edit-box" style="display:none;">
        <textarea class="ai-popup-edit-textarea" rows="2">${escapeHtml(userQuery)}</textarea>
        <div class="ai-popup-edit-actions">
          <button type="button" class="ai-popup-edit-cancel">Cancel</button>
          <button type="button" class="ai-popup-edit-save">Save & Send</button>
        </div>
      </div>
    `;
    userInterruptedScroll = false;
    attachPopupUserTurnHandlers(userGroup, turnId);
    thread.appendChild(userGroup);
    requestAnimationFrame(() => { thread.scrollTop = thread.scrollHeight; });

    // 2. Assistant Card
    const matched = findRelevantArticles(userQuery, 3);
    const card = document.createElement('div');
    card.className = 'ai-popup-card';
    card.dataset.turnId = turnId;

    const cardHeader = document.createElement('div');
    cardHeader.className = 'ai-popup-card-header';
    cardHeader.innerHTML = `
      <span><strong>Synthreat AI</strong></span>
      <div class="ai-card-header-actions">
        <span class="ai-card-status">Generating...</span>
        <button type="button" class="ai-popup-card-del-btn" title="Delete turn" aria-label="Delete turn">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>
      </div>
    `;
    cardHeader.querySelector('.ai-popup-card-del-btn')?.addEventListener('click', () => deletePopupTurn(turnId));
    card.appendChild(cardHeader);

    const body = document.createElement('div');
    body.className = 'ai-popup-card-body';
    body.innerHTML = '<span class="spinner" style="display:inline-block; border-color:var(--ink-faint); border-top-color:var(--accent);"></span> Connecting to Gemini...';
    card.appendChild(body);

    if (matched.length > 0) {
      const cites = document.createElement('div');
      cites.className = 'ai-popup-citations';
      cites.innerHTML = `<strong>Grounded:</strong> ${matched.map(m => `<a href="${base}${m.col}/${m.slug}/" class="ai-popup-cite-badge" target="_blank" rel="noopener">${escapeHtml(m.title)}</a>`).join('')}`;
      card.appendChild(cites);
    }

    thread.appendChild(card);
    requestAnimationFrame(() => { thread.scrollTop = thread.scrollHeight; updateJumpButtonVisibility(); });


    setGenerating(true);
    let fullText = '';

    try {
      const systemPrompt = buildPopupPrompt(matched);

      const userParts: any[] = [];
      let queryForPrompt = userQuery;
      if (attached) {
        if (attached.type === 'text') {
          queryForPrompt = (queryForPrompt ? queryForPrompt + '\n\n' : '') +
            `--- Attached Document: ${attached.name} ---\n${attached.textContent || ''}\n--- End Document ---`;
        } else if (!queryForPrompt) {
          queryForPrompt = `Analyze this attached ${attached.name} (${attached.type}) for security vulnerabilities, technical root causes, and business risk.`;
        }
      }
      userParts.push({ text: queryForPrompt });

      if (attached?.type === 'image' && attached.data) {
        userParts.push({
          inline_data: {
            mime_type: attached.mimeType || 'image/jpeg',
            data: attached.data
          }
        });
      } else if (attached?.type === 'pdf' && attached.data) {
        userParts.push({
          inline_data: {
            mime_type: 'application/pdf',
            data: attached.data
          }
        });
      }

      const contents = [
        ...popupHistory,
        { role: 'user', parts: userParts }
      ];

      const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:streamGenerateContent?key=${apiKey}&alt=sse`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          system_instruction: { parts: [{ text: systemPrompt }] },
          contents,
          generationConfig: { temperature: 0.25, maxOutputTokens: 450 }
        })
      });

      if (!res.ok) throw new Error(`API error (${res.status})`);

      const reader = res.body?.getReader();
      if (!reader) throw new Error('Stream unreadable');
      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            const raw = line.slice(6).trim();
            if (!raw) continue;
            try {
              const parsed = JSON.parse(raw);
              const parts = parsed.candidates?.[0]?.content?.parts || [];
              let chunk = '';
              for (const p of parts) {
                if (!p.thought && p.text) chunk += p.text;
              }
              if (chunk) {
                fullText += chunk;
                body.innerHTML = marked.parse(fullText) as string;
                if (!userInterruptedScroll) {
                  thread.scrollTop = thread.scrollHeight;
                }
                updateJumpButtonVisibility();
              }
            } catch {}
          }
        }
      }

      // Flush trailing buffer
      if (buffer.trim()) {
        const trailingLines = buffer.split('\n');
        for (const line of trailingLines) {
          if (line.startsWith('data: ')) {
            const raw = line.slice(6).trim();
            if (!raw) continue;
            try {
              const parsed = JSON.parse(raw);
              const parts = parsed.candidates?.[0]?.content?.parts || [];
              for (const p of parts) {
                if (!p.thought && p.text) fullText += p.text;
              }
            } catch {}
          }
        }
      }

      // Fallback if fullText is somehow empty (e.g. rate limit, empty token candidate)
      if (!fullText.trim()) {
        fullText = isConversational(userQuery)
          ? 'Systems operational. Synthreat AI is ready to assist your security operations. How can I help you today?'
          : 'I received your query. Please specify a security topic or rephrase your question.';
      }

      body.innerHTML = marked.parse(fullText) as string;

      const techMatch = fullText.match(/(?:##\s*🛠?[^\n]*Technical[^\n]*\n)([\s\S]*?)(?=(?:##\s*💼?[^\n]*Business)|$)/i);
      const bizMatch = fullText.match(/(?:##\s*💼?[^\n]*Business[^\n]*\n)([\s\S]*?)$/i);

      const statusSpan = cardHeader.querySelector('.ai-card-status');
      if (statusSpan) {
        if (techMatch && bizMatch) {
          statusSpan.textContent = 'Dual Perspective';
        } else {
          statusSpan.textContent = 'Response';
        }
      }

      // Add toolbar
      const toolbar = document.createElement('div');
      toolbar.className = 'ai-popup-toolbar';

      let hasSpecial = false;

      if (bizMatch) {
        hasSpecial = true;
        const copyBiz = document.createElement('button');
        copyBiz.className = 'ai-popup-tool-btn';
        copyBiz.innerHTML = `<span>Copy Talk Track</span>`;
        copyBiz.addEventListener('click', () => {
          navigator.clipboard.writeText(bizMatch[1].trim());
          copyBiz.classList.add('success');
          copyBiz.textContent = 'Copied!';
          setTimeout(() => { copyBiz.classList.remove('success'); copyBiz.textContent = 'Copy Talk Track'; }, 2000);
        });
        toolbar.appendChild(copyBiz);
      }

      if (techMatch) {
        hasSpecial = true;
        const copyTech = document.createElement('button');
        copyTech.className = 'ai-popup-tool-btn';
        copyTech.innerHTML = `<span>Copy Tech Fix</span>`;
        copyTech.addEventListener('click', () => {
          navigator.clipboard.writeText(techMatch[1].trim());
          copyTech.classList.add('success');
          copyTech.textContent = 'Copied!';
          setTimeout(() => { copyTech.classList.remove('success'); copyTech.textContent = 'Copy Tech Fix'; }, 2000);
        });
        toolbar.appendChild(copyTech);
      }

      if (!hasSpecial) {
        const copyAll = document.createElement('button');
        copyAll.className = 'ai-popup-tool-btn';
        copyAll.innerHTML = `<span>Copy Response</span>`;
        copyAll.addEventListener('click', () => {
          navigator.clipboard.writeText(fullText);
          copyAll.classList.add('success');
          copyAll.textContent = 'Copied!';
          setTimeout(() => { copyAll.classList.remove('success'); copyAll.textContent = 'Copy Response'; }, 2000);
        });
        toolbar.appendChild(copyAll);
      }

      // Delete Turn action button in toolbar
      const deleteBtn = document.createElement('button');
      deleteBtn.className = 'ai-popup-tool-btn danger';
      deleteBtn.innerHTML = `
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        <span>Delete</span>
      `;
      deleteBtn.addEventListener('click', () => deletePopupTurn(turnId));
      toolbar.appendChild(deleteBtn);

      card.appendChild(toolbar);

      popupTurns.push({
        id: turnId,
        userQuery,
        assistantText: fullText,
        matched,
        attachment: attached ? { name: attached.name, size: attached.size, type: attached.type, dataUrl: attached.dataUrl } : undefined
      });
      popupHistory.push({ role: 'user', parts: [{ text: userQuery }] });
      popupHistory.push({ role: 'model', parts: [{ text: fullText }] });
      savePopupState();
      updatePopupClearVisibility(true);
      if (!userInterruptedScroll) {
        thread.scrollTop = thread.scrollHeight;
      }
      updateJumpButtonVisibility();
    } catch (err: any) {
      body.innerHTML = `
        <div style="color:#ef4444;">
          <strong>Error:</strong> ${escapeHtml(err.message || 'Generation failed')}
          <div style="margin-top:6px;">
            <button type="button" class="ai-popup-tool-btn retry-btn" style="font-size:11px;">Retry</button>
            <button type="button" class="ai-popup-tool-btn danger del-btn" style="font-size:11px; margin-left:4px;">Delete</button>
          </div>
        </div>
      `;
      body.querySelector('.retry-btn')?.addEventListener('click', () => {
        deletePopupTurn(turnId);
        submitPopupPrompt(userQuery);
      });
      body.querySelector('.del-btn')?.addEventListener('click', () => {
        deletePopupTurn(turnId);
      });
    } finally {
      setGenerating(false);
      thread.scrollTop = thread.scrollHeight;
    }
  }

  function setGenerating(loading: boolean) {
    isGenerating = loading;
    if (sendBtn) sendBtn.disabled = loading;
    const spinner = sendBtn?.querySelector('.spinner') as HTMLElement;
    const sendIcon = sendBtn?.querySelector('.send-icon') as HTMLElement;
    if (spinner) spinner.style.display = loading ? 'inline-block' : 'none';
    if (sendIcon) sendIcon.style.display = loading ? 'none' : 'inline';
  }

  function escapeHtml(str: string) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

